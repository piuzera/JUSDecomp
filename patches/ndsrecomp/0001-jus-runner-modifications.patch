+            if (button == p.first) {
+                bit = p.second;
+                break;
+            }
+        }
+        if (bit == 0) {
+            std::fprintf(stderr, "[input] unknown DS button name '%s' "
+                                 "(expected a b select start right left up "
+                                 "down r l x y) — skipped\n",
+                         binding.button.c_str());
+            continue;
+        }
+        SDL_Scancode key = scancode_from_binding_name(binding.key);
+        if (key == SDL_SCANCODE_UNKNOWN) {
+            std::fprintf(stderr, "[input] unknown key name '%s' for button "
+                                 "'%s' — skipped\n",
+                         binding.key.c_str(), binding.button.c_str());
+            continue;
+        }
+        // The custom key fully owns this DS button: drop the default rule
+        // for the button, and drop any other rule already using this key so
+        // one host key can never press two DS buttons.
+        rules.erase(std::remove_if(rules.begin(), rules.end(),
+                                   [&](const KeyRule& r) {
+                                       return r.bit == bit || r.key == key;
+                                   }),
+                    rules.end());
+        rules.push_back({key, bit});
+        std::fprintf(stderr, "[input] keyboard: '%s' -> DS %s\n",
+                     binding.key.c_str(), binding.button.c_str());
+    }
+    g_key_rules = std::move(rules);
+}
