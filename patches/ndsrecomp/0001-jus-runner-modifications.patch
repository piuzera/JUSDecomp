+// ── Generic pad-button -> touchscreen-tap runtime (title-agnostic) ─────
+// Unlike MPH Prime Controls, this has no ROM allowlist and no relative-
+// mouse gate: it is always active whenever a controller is connected.
+// Motivating case: JUS's L/R battle assist-summon shortcuts cover only 2
+// support koma; extra arcade-stick buttons can each synthesize a tap at a
+// player-calibrated coordinate for a 3rd/4th support panel, entirely from
+// game.toml/CLI config -- no game-code patch required.
+struct PadTapRuntimeState {
+    NdsPadTapAction action;
+    MphPadBinding binding;
+    bool held = false;  // edge-detect state; covers buttons and triggers
+};
+
+std::vector<PadTapRuntimeState> make_pad_tap_runtime(
+    const std::vector<NdsPadTapAction>& actions) {
+    std::vector<PadTapRuntimeState> runtime;
+    runtime.reserve(actions.size());
+    for (const NdsPadTapAction& action : actions) {
+        bool recognized = true;
+        const MphPadBinding binding =
+            parse_mph_pad_binding(action.button, &recognized);
+        if (!recognized || binding.kind == MphPadInputKind::None) {
+            std::fprintf(stderr,
+                "[sdl] invalid controls.taps button \"%s\" (tap at %u,%u "
+                "ignored)\n",
+                action.button.c_str(), static_cast<unsigned>(action.x),
+                static_cast<unsigned>(action.y));
+            continue;
+        }
+        runtime.push_back(PadTapRuntimeState{action, binding, false});
+    }
+    return runtime;
+}
