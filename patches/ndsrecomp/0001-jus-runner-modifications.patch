+// QOL screenshot: save the two native 256x192 framebuffers as one stacked
+// 256x384 24-bit BMP (top above bottom). BMP is deliberately used for v1 --
+// it needs no external image library.
+bool save_stacked_bmp(const std::string& dir, uint32_t index,
+                      const uint32_t* top, const uint32_t* bottom) {
+    constexpr int kW = kScreenWidth;
+    constexpr int kH = kScreenHeight * 2;
+    const int row_bytes = kW * 3;
+    const int pad = (4 - (row_bytes % 4)) % 4;
+    const int data_size = (row_bytes + pad) * kH;
+    const uint32_t file_size = 54u + static_cast<uint32_t>(data_size);
+    const std::string name =
+        dir + "/jus_shot_" + std::to_string(index) + ".bmp";
+    FILE* f = std::fopen(name.c_str(), "wb");
+    if (!f) return false;
+    uint8_t header[54] = {};
+    header[0] = 'B';
+    header[1] = 'M';
+    header[2] = static_cast<uint8_t>(file_size & 0xFFu);
+    header[3] = static_cast<uint8_t>((file_size >> 8) & 0xFFu);
+    header[4] = static_cast<uint8_t>((file_size >> 16) & 0xFFu);
+    header[5] = static_cast<uint8_t>((file_size >> 24) & 0xFFu);
+    header[10] = 54;
+    uint32_t ih = 40;
+    std::memcpy(header + 14, &ih, 4);
+    int32_t iw = kW;
+    std::memcpy(header + 18, &iw, 4);
+    int32_t ihh = kH;
+    std::memcpy(header + 22, &ihh, 4);
+    uint16_t planes = 1;
+    std::memcpy(header + 26, &planes, 2);
+    uint16_t bpp = 24;
+    std::memcpy(header + 28, &bpp, 2);
+    uint32_t compression = 0;
+    std::memcpy(header + 30, &compression, 4);
+    uint32_t img_size = static_cast<uint32_t>(data_size);
+    std::memcpy(header + 34, &img_size, 4);
+    uint32_t ppm = 2835;
+    std::memcpy(header + 38, &ppm, 4);
+    std::memcpy(header + 42, &ppm, 4);
+    std::fwrite(header, 1, 54, f);
+    // BMP pixel rows are stored bottom-up: file row 0 is the image bottom.
+    // Iteration y writes file row (kH - 1 - y), so the first write (y = kH-1)
+    // lands at file row 0. Map the two buffers so the final image shows the
+    // top screen upright in the top half and the bottom screen upright below:
+    //   - y in [kScreenHeight, kH-1] -> file rows 0..kScreenHeight-1 (bottom
+    //     half of the image) carry the bottom buffer, bottom[0] at image-top
+    //     of that half (file row kScreenHeight-1).
+    //   - y in [0, kScreenHeight-1]  -> file rows kScreenHeight..kH-1 (top
+    //     half of the image) carry the top buffer, top[0] at the image top.
+    std::vector<uint8_t> row(static_cast<size_t>(row_bytes + pad));
+    for (int y = kH - 1; y >= 0; --y) {
+        const uint32_t* src =
+            (y >= kScreenHeight)
+                ? bottom + static_cast<size_t>(y - kScreenHeight) * kW
+                : top + static_cast<size_t>(y) * kW;
+        for (int x = 0; x < kW; ++x) {
+            const uint32_t px = src[x];
+            row[static_cast<size_t>(x) * 3 + 0] = static_cast<uint8_t>(px);
+            row[static_cast<size_t>(x) * 3 + 1] =
+                static_cast<uint8_t>(px >> 8);
+            row[static_cast<size_t>(x) * 3 + 2] =
+                static_cast<uint8_t>(px >> 16);
+        }
+        for (int p = 0; p < pad; ++p)
+            row[static_cast<size_t>(row_bytes + p)] = 0;
+        std::fwrite(row.data(), 1, row.size(), f);
+    }
+    std::fclose(f);
+    return true;
+}
