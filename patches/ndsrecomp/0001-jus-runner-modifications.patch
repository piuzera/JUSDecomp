+bool nds_parse_pad_tap_action(const std::string& spec, NdsPadTapAction* out) {
+    if (!out || spec.empty()) return false;
+    std::vector<std::string> fields;
+    size_t start = 0;
+    while (start <= spec.size()) {
+        const size_t colon = spec.find(':', start);
+        if (colon == std::string::npos) {
+            fields.push_back(spec.substr(start));
+            break;
+        }
+        fields.push_back(spec.substr(start, colon - start));
+        start = colon + 1;
+    }
+    if (fields.size() != 3 && fields.size() != 5) return false;
+    for (const std::string& f : fields) {
+        if (f.empty()) return false;
+    }
+    auto parse_uint = [](const std::string& s, long min_v, long max_v,
+                         long* value) {
+        char* end = nullptr;
+        const long parsed = std::strtol(s.c_str(), &end, 10);
+        if (!end || *end != '\0' || parsed < min_v || parsed > max_v)
+            return false;
+        *value = parsed;
+        return true;
+    };
+    long x = 0, y = 0, tap_frames = 2, release_frames = 2;
+    if (!parse_uint(fields[1], 0, 255, &x)) return false;
+    if (!parse_uint(fields[2], 0, 191, &y)) return false;
+    if (fields.size() == 5) {
+        if (!parse_uint(fields[3], 1, 255, &tap_frames)) return false;
+        if (!parse_uint(fields[4], 1, 255, &release_frames)) return false;
+    }
+    NdsPadTapAction action{};
+    action.button = fields[0];
+    action.x = static_cast<uint16_t>(x);
+    action.y = static_cast<uint16_t>(y);
+    action.tap_frames = static_cast<uint8_t>(tap_frames);
+    action.release_frames = static_cast<uint8_t>(release_frames);
+    *out = action;
+    return true;
+}
