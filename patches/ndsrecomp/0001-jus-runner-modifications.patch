+// QOL: window-geometry persistence. A tiny key=value file stores the last
+// windowed position/size so the player's window arrangement survives
+// relaunches (skipped entirely in fullscreen mode).
+bool load_window_state_file(const char* path, int* x, int* y,
+                            int* w, int* h) {
+    if (!path || !path[0] || !x || !y || !w || !h) return false;
+    FILE* f = std::fopen(path, "r");
+    if (!f) return false;
+    int vals[4] = {0, 0, 0, 0};
+    bool have[4] = {false, false, false, false};
+    char line[128];
+    while (std::fgets(line, sizeof(line), f)) {
+        int v = 0;
+        if (std::sscanf(line, "x=%d", &v) == 1) {
+            vals[0] = v; have[0] = true;
+        } else if (std::sscanf(line, "y=%d", &v) == 1) {
+            vals[1] = v; have[1] = true;
+        } else if (std::sscanf(line, "w=%d", &v) == 1) {
+            vals[2] = v; have[2] = true;
+        } else if (std::sscanf(line, "h=%d", &v) == 1) {
+            vals[3] = v; have[3] = true;
+        }
+    }
+    std::fclose(f);
+    if (!have[0] || !have[1] || !have[2] || !have[3]) return false;
+    *x = vals[0]; *y = vals[1]; *w = vals[2]; *h = vals[3];
+    return true;
+}
+
+void save_window_state_file(const char* path, int x, int y, int w, int h) {
+    if (!path || !path[0]) return;
+    FILE* f = std::fopen(path, "w");
+    if (!f) return;
+    std::fprintf(f, "x=%d\ny=%d\nw=%d\nh=%d\n", x, y, w, h);
+    std::fclose(f);
+}
