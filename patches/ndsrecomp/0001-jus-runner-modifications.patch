+// The F9 recomp settings menu: full-screen dark backdrop + title + option
+// list with a selection cursor + hint line. Rendered into a scratch copy of
+// the top framebuffer (the guest surface is never modified).
+void draw_recomp_menu(uint32_t* fb, int fb_w, int cursor, int row_count,
+                      const char* const* labels,
+                      const char* const* values,
+                      const bool* restart_required) {
+    constexpr int kScale = 2;
+    constexpr int kRowH = 12;  // 2 * (5 glyph rows + 1 gap)
+    for (int y = 0; y < kScreenHeight; ++y)
+        for (int x = 0; x < fb_w; ++x)
+            fb[y * fb_w + x] = 0xFF14141Cu;
+
+    const char* title = "RECOMP SETTINGS";
+    const int title_x = (fb_w - static_cast<int>(std::strlen(title)) * 4 * kScale) / 2;
+    draw_text_3x5_scaled(fb, fb_w, std::max(0, title_x), 8, title,
+                         0xFFFFFFFFu, kScale);
+    const int value_x = fb_w - 96;
+    const int mark_x = fb_w - 30;
+    for (int i = 0; i < row_count && i < 14; ++i) {
+        const int y = 30 + i * kRowH;
+        if (i == cursor)
+            draw_text_3x5_scaled(fb, fb_w, 12, y, ">", 0xFFFFD700u, kScale);
+        draw_text_3x5_scaled(fb, fb_w, 24, y, labels[i], 0xFFE0E0E0u, kScale);
+        if (values && values[i])
+            draw_text_3x5_scaled(fb, fb_w, value_x, y, values[i],
+                                 0xFF66C2FFu, kScale);
+        if (restart_required && restart_required[i])
+            draw_text_3x5_scaled(fb, fb_w, mark_x, y, "(R)", 0xFF707070u,
+                                 kScale);
+    }
+    const char* hint = "UP/DOWN MOVE  LEFT/RIGHT CHANGE  ENTER OK  ESC CLOSE";
+    constexpr int kHintScale = 1;
+    const int hint_x =
+        (fb_w - static_cast<int>(std::strlen(hint)) * 4 * kHintScale) / 2;
+    draw_text_3x5_scaled(fb, fb_w, std::max(0, hint_x), kScreenHeight - 18,
+                         hint, 0xFF9AA0A0u, kHintScale);
+}
