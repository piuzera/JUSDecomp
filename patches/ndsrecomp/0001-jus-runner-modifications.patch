+constexpr unsigned char font_3x5_character(unsigned char c) {
+    return c >= 'a' && c <= 'z'
+        ? static_cast<unsigned char>(c - 'a' + 'A')
+        : c;
+}
+
+constexpr bool font_3x5_row_has_pixel(uint8_t bits, int col) {
+    return (bits & (1u << (2 - col))) != 0;
+}
+
+static_assert(font_3x5_character('a') == 'A');
+static_assert(font_3x5_row_has_pixel(kFont3x5['C' - 32][1], 0));
+static_assert(!font_3x5_row_has_pixel(kFont3x5['C' - 32][1], 2));
+static_assert(font_3x5_row_has_pixel(kFont3x5['>' - 32][0], 0));
+static_assert(font_3x5_row_has_pixel(kFont3x5['>' - 32][2], 2));
+
+void draw_text_3x5(uint32_t* fb, int fb_w, int x, int y,
+                   const char* text, uint32_t color) {
+    for (const char* p = text; *p; ++p) {
+        const unsigned char c =
+            font_3x5_character(static_cast<unsigned char>(*p));
+        if (c < 32 || c > 126) { x += 4; continue; }
+        const uint8_t* g = kFont3x5[c - 32];
+        for (int row = 0; row < 5; ++row) {
+            const uint8_t bits = g[row];
+            for (int col = 0; col < 3; ++col) {
+                if (!font_3x5_row_has_pixel(bits, col)) continue;
+                const int px = x + col;
+                const int py = y + row;
+                if (px >= 0 && px < fb_w && py >= 0 && py < kScreenHeight)
+                    fb[py * fb_w + px] = color;
+            }
+        }
+        x += 4;
+    }
+}
+
+void draw_overlay_line(uint32_t* fb, int fb_w, int x, int y,
+                       const char* text, uint32_t color) {
+    const size_t len = std::strlen(text);
+    const int box_w = static_cast<int>(len) * 4 + 2;
+    for (int yy = 0; yy < 6; ++yy) {
+        for (int xx = 0; xx < box_w; ++xx) {
+            const int px = x + xx;
+            const int py = y + yy;
+            if (px >= 0 && px < fb_w && py >= 0 && py < kScreenHeight)
+                fb[py * fb_w + px] = 0xFF000000u;
+        }
+    }
+    draw_text_3x5(fb, fb_w, x + 1, y + 1, text, color);
+}
+
+// Integer-scaled variant of the 3x5 bitmap font (each glyph pixel becomes a
+// scale x scale block). Used by the F9 recomp settings menu for readability.
+void draw_text_3x5_scaled(uint32_t* fb, int fb_w, int x, int y,
+                          const char* text, uint32_t color, int scale) {
+    if (scale < 1) scale = 1;
+    for (const char* p = text; *p; ++p) {
+        const unsigned char c =
+            font_3x5_character(static_cast<unsigned char>(*p));
+        if (c < 32 || c > 126) { x += 4 * scale; continue; }
+        const uint8_t* g = kFont3x5[c - 32];
+        for (int row = 0; row < 5; ++row) {
+            const uint8_t bits = g[row];
+            for (int col = 0; col < 3; ++col) {
+                if (!font_3x5_row_has_pixel(bits, col)) continue;
+                for (int dy = 0; dy < scale; ++dy) {
+                    for (int dx = 0; dx < scale; ++dx) {
+                        const int px = x + col * scale + dx;
+                        const int py = y + row * scale + dy;
+                        if (px >= 0 && px < fb_w && py >= 0 &&
+                            py < kScreenHeight) {
+                            fb[py * fb_w + px] = color;
+                        }
+                    }
+                }
+            }
+        }
+        x += 4 * scale;
+    }
+}
