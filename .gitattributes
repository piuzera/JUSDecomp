# Normalize text line endings; keep generated/tool binaries out of text diffs.
* text=auto

# Source code
*.py   text eol=lf
*.c    text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.s    text eol=lf
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=crlf
*.cmd  text eol=crlf

# Binary data (never produced, but if present in future: no text conversion)
*.bin  binary
*.dtx  binary
*.aar  binary
*.nds  binary
*.sav  binary
*.png  binary
*.exe  binary
*.dll  binary
*.zip  binary
