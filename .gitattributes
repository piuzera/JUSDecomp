# Normalize text line endings; keep generated/tool binaries out of text diffs.
* text=auto

# Source code
*.py   text eol=lf
*.c    text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.s    text eol=lf
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=crlf
*.cmd  text eol=crlf

# Binary data (never produced, but if present in future: no text conversion)
*.bin  binary
*.dtx  binary
*.aar  binary
*.nds  binary
*.sav  binary
*.png  binary
*.exe  binary
*.dll  binary
*.zip  binary

# Preserve literal unified-diff context in this reviewed patch artifact.
decomp/matching-notes/other-cpus/arm7-checked-view.patch whitespace=-blank-at-eol
decomp/matching-notes/other-cpus/arm7-module-input.patch whitespace=-blank-at-eol
decomp/matching-notes/other-cpus/arm7-observation.patch whitespace=-blank-at-eol

# Keep pinned decoder evidence bytes stable in a fresh checkout.
decomp/matching-notes/other-cpus/branch-decoder-repair/** text eol=lf
decomp/matching-notes/other-cpus/branch-decoder-repair/dsd-branch-dependency-repair.patch whitespace=-blank-at-eol
