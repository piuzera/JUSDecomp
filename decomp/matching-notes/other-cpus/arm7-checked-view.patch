+#[test]
+fn nitrofs_overlay_extent_and_count_arithmetic_rejects() {
+    for (offset, size, expected) in [
+        (0xfffffff0, 32, Arm7LayoutError::Overflow),
+        (0xc000, 32, Arm7LayoutError::Bounds),
+        (0x5201, 32, Arm7LayoutError::Alignment),
+        (0x5200, 96, Arm7LayoutError::NitroFs),
+        (0x5200, 33, Arm7LayoutError::NitroFs),
+    ] {
+        let mut f = Fixture::new();
+        put(&mut f.parent, 0x4c, 16);
+        f.parent[0x500c..0x500e].copy_from_slice(&1u16.to_le_bytes());
+        put(&mut f.parent, 0x5108, 0x6000);
+        put(&mut f.parent, 0x510c, 0xb000);
+        put(&mut f.parent, 0x50, offset);
+        put(&mut f.parent, 0x54, size);
+        f.child_layout.identity.parent_rom_sha256 = sha(&f.parent);
+        let result = std::panic::catch_unwind(|| f.child_layout.checked(&f.parent));
+        assert!(
+            matches!(result, Ok(Err(error)) if error == expected),
+            "wrong rejection for overlay offset {offset:x} size {size}"
+        );
+    }
+}
