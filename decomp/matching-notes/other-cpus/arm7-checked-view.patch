+#[test]
+fn nitrofs_decoding_errors_and_decoded_sibling_aliases_reject() {
+    let mut accepted = Vec::new();
+    for (names, selected) in [
+        (vec![1, 0x81, 1, 0x82, 0], "\u{fffd}"),
+        (vec![2, 0x87, 0x90, 2, 0x81, 0xe0, 0], "\u{2252}"),
+    ] {
+        let mut f = Fixture::new();
+        f.parent[0x501c..0x501c + names.len()].copy_from_slice(&names);
+        put(&mut f.parent, 0x4c, 16);
+        put(&mut f.parent, 0x5108, 0x6000);
+        put(&mut f.parent, 0x510c, 0xb000);
+        f.child_layout.identity.parent_rom_sha256 = sha(&f.parent);
+        f.child_layout.identity.program =
+            ProgramSelector::NitroFs { path: format!("ChildRom/{selected}") };
+        if !matches!(f.child_layout.checked(&f.parent), Err(Arm7LayoutError::NitroFs)) {
+            accepted.push(selected);
+        }
+    }
+    assert!(accepted.is_empty(), "accepted decoded names {accepted:?}");
+}
