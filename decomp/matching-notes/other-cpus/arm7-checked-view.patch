+#[test]
+fn region_gap_overlap_order_missing_and_table_tail_reject() {
+    let f = Fixture::new();
+    for case in 0..5 {
+        let mut layout = f.parent_layout.clone();
+        match case {
+            0 => layout.regions[1].stored_extent.start += 4,
+            1 => layout.regions[1].stored_extent.start -= 4,
+            2 => layout.regions.swap(1, 2),
+            3 => {
+                layout.regions.pop();
+            }
+            _ => layout.table_extent.end -= 4,
+        }
+        assert!(layout.checked(&f.parent).is_err());
+    }
