+#[test]
+fn parent_and_child_views_use_distinct_program_identity() {
+    let f = Fixture::new();
+    let parent = f.parent_layout.checked(&f.parent).unwrap();
+    let child = f.child_layout.checked(&f.parent).unwrap();
+    assert_eq!(parent.startup().bytes().len(), 64);
+    assert_eq!(parent.autoloads().len(), 2);
+    assert_eq!(parent.table().len(), 24);
+    assert_eq!(parent.autoloads()[0].bytes(), child.autoloads()[0].bytes());
+    assert_ne!(parent.identity().program_sha256, child.identity().program_sha256);
+    assert_eq!(parent.matched_source_bytes(), 0);
+}
+#[test]
+fn wrong_parent_program_and_image_pins_reject() {
+    let f = Fixture::new();
+    for field in 0..3 {
+        let mut layout = f.parent_layout.clone();
+        match field {
+            0 => layout.identity.parent_rom_sha256 = "0".repeat(64),
+            1 => layout.identity.program_sha256 = "0".repeat(64),
+            _ => layout.image_sha256 = "0".repeat(64),
+        }
+        assert!(layout.checked(&f.parent).is_err());
+    }
+}
