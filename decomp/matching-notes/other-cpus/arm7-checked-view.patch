+use ds_decomp::rom::arm7::{
+    Arm7Layout, Arm7LayoutError, Arm7Region, Arm7RegionKind, Cpu, InstructionSet, Processor,
+    ProgramIdentity, ProgramSelector, TargetPolicy,
+};
+use sha2::{Digest, Sha256};
+
+fn sha(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn put(bytes: &mut [u8], offset: usize, word: u32) {
+    bytes[offset..offset + 4].copy_from_slice(&word.to_le_bytes());
+}
+
+struct Fixture {
+    parent: Vec<u8>,
+    parent_layout: Arm7Layout,
+    child_layout: Arm7Layout,
+}
+impl Fixture {
+    fn new() -> Self {
+        let base = 0x02380000;
+        let mut image = (0..120).map(|i| i as u8).collect::<Vec<_>>();
+        for (i, value) in
+            [base + 96, base + 120, base + 64, base + 64, base + 64].into_iter().enumerate()
+        {
+            put(&mut image, 32 + i * 4, value);
+        }
+        for (i, value) in [0x037f8000, 16, 8, 0x027e0000, 16, 4].into_iter().enumerate() {
+            put(&mut image, 96 + i * 4, value);
+        }
+        fn program(size: usize, offset: u32, image: &[u8]) -> Vec<u8> {
+            let mut bytes = vec![0; size];
+            for (i, value) in
+                [offset, 0x02380000, 0x02380000, image.len() as u32].into_iter().enumerate()
+            {
+                put(&mut bytes, 0x30 + i * 4, value);
+            }
+            bytes[offset as usize..offset as usize + image.len()].copy_from_slice(image);
+            bytes
+        }
+        let child = program(0x5000, 0x4000, &image);
+        let mut parent = program(0xc000, 0x4000, &image);
+        parent[0x6000..0xb000].copy_from_slice(&child);
+        for (i, value) in [0x5000, 40, 0x5100, 8].into_iter().enumerate() {
+            put(&mut parent, 0x40 + i * 4, value);
+        }
+        put(&mut parent, 0x5000, 16);
+        parent[0x5006..0x5008].copy_from_slice(&2u16.to_le_bytes());
+        put(&mut parent, 0x5008, 28);
+        parent[0x500e..0x5010].copy_from_slice(&0xf000u16.to_le_bytes());
+        parent[0x5010..0x501c].copy_from_slice(b"\x88ChildRom\x01\xf0\0");
+        parent[0x501c..0x5028].copy_from_slice(b"\x0apublic.srl\0");
+        put(&mut parent, 0x5100, 0x6000);
+        put(&mut parent, 0x5104, 0xb000);
+        let layout = |program, program_sha256, image_offset, header_sha256| Arm7Layout {
+            identity: ProgramIdentity { parent_rom_sha256: sha(&parent), program, program_sha256 },
+            target: TargetPolicy {
+                cpu: Cpu::Arm7,
+                isa: InstructionSet::ArmV4T,
+                processor: Processor::Arm7Tdmi,
+            },
+            header_sha256,
+            image_offset,
+            image_bytes: 120,
+            image_sha256: sha(&image),
+            base,
+            entry: base,
+            params_offset: 32,
+            params_sha256: sha(&image[32..52]),
+            table_extent: 96..120,
+            table_sha256: sha(&image[96..]),
+            regions: vec![
+                Arm7Region {
+                    kind: Arm7RegionKind::Startup,
+                    stored_extent: 0..64,
+                    runtime_base: base,
+                    bss_bytes: 0,
+                    sha256: sha(&image[..64]),
+                },
+                Arm7Region {
+                    kind: Arm7RegionKind::Autoload(0),
+                    stored_extent: 64..80,
+                    runtime_base: 0x037f8000,
+                    bss_bytes: 8,
+                    sha256: sha(&image[64..80]),
+                },
+                Arm7Region {
+                    kind: Arm7RegionKind::Autoload(1),
+                    stored_extent: 80..96,
+                    runtime_base: 0x027e0000,
+                    bss_bytes: 4,
+                    sha256: sha(&image[80..96]),
+                },
+            ],
+        };
+        let parent_layout =
+            layout(ProgramSelector::Parent, sha(&parent), 0x4000, sha(&parent[..0x4000]));
+        let child_layout = layout(
+            ProgramSelector::NitroFs { path: "ChildRom/public.srl".into() },
+            sha(&child),
+            0x4000,
+            sha(&child[..0x4000]),
+        );
+        Self { parent, parent_layout, child_layout }
+    }
+    fn image(&mut self) -> &mut [u8] {
+        &mut self.parent[0x4000..0x4078]
+    }
+    fn repin_image(&mut self) {
+        self.parent_layout.params_sha256 = sha(&self.parent[0x4020..0x4034]);
+        self.parent_layout.image_sha256 = sha(&self.parent[0x4000..0x4078]);
+        self.parent_layout.regions[0].sha256 = sha(&self.parent[0x4000..0x4040]);
+        self.parent_layout.identity.parent_rom_sha256 = sha(&self.parent);
+        self.parent_layout.identity.program_sha256 = sha(&self.parent);
+    }
+    fn repin_parent(&mut self) {
+        self.parent_layout.identity.parent_rom_sha256 = sha(&self.parent);
+        self.parent_layout.identity.program_sha256 = sha(&self.parent);
+    }
+}
