@@ -0,0 +1,87 @@
+//! Read-only physical module and explicitly pinned short-span observations.
+use ds_decomp::{
+    config::symbol::InstructionMode,
+    rom::arm7::{Arm7Layout, Arm7RegionKind, ProgramIdentity},
+};
+use serde::Deserialize;
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::{error::Error, fs, io, ops::Range};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SelectedSpan {
+    program: ProgramIdentity,
+    region: Arm7RegionKind,
+    mode: InstructionMode,
+    extent: Range<u32>,
+}
+fn sha(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn main() -> Result<(), Box<dyn Error>> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args.len() != 5 {
+        return Err(
+            "usage: arm7_module_probe ROM LAYOUT_JSON LAYOUT_SHA256 SPANS_JSON SPANS_SHA256".into(),
+        );
+    }
+    let parent = fs::read(&args[0])?;
+    let sidecar = fs::read(&args[1])?;
+    let span_sidecar = fs::read(&args[3])?;
+    if sha(&sidecar) != args[2] || sha(&span_sidecar) != args[4] {
+        return Err("independent layout/span sidecar hash mismatch".into());
+    }
+    let layouts: Vec<Arm7Layout> = serde_json::from_slice(&sidecar)?;
+    let spans: Vec<SelectedSpan> = serde_json::from_slice(&span_sidecar)?;
+    if layouts.is_empty() || spans.is_empty() {
+        return Err("no physical layouts or explicit span observations supplied".into());
+    }
+    let mut programs = Vec::new();
+    let mut observed = vec![false; spans.len()];
+    for layout in layouts {
+        let view = layout.checked(&parent)?;
+        let mut modules = Vec::new();
+        let mut observations = Vec::new();
+        for module in view.module_inputs() {
+            let identity = module.identity();
+            modules.push(json!({"identity":identity,"initialized":module.initialized(),"bss":module.bss(),
+                "initialized_bytes":module.bytes().len(),"sha256":sha(module.bytes()),"target":module.target(),
+                "code_data_classification":"unresolved","source_bytes":0}));
+            for (index, span) in spans.iter().enumerate() {
+                if identity.program() != &span.program || identity.region() != &span.region {
+                    continue;
+                }
+                if observed[index] {
+                    return Err("span identity matched more than one selected module".into());
+                }
+                let instructions = module.decode_span(span.mode, span.extent.clone())?;
+                let base = module.initialized().start;
+                let bytes = &module.bytes()
+                    [(span.extent.start - base) as usize..(span.extent.end - base) as usize];
+                observations.push(json!({"identity":identity,"mode":span.mode,"extent":span.extent,
+                    "bytes":bytes.len(),"input_sha256":sha(bytes),"instruction_count":instructions.len(),
+                    "target":module.target(),"executable_coverage_established":false,"function_extent_established":false}));
+                observed[index] = true;
+            }
+        }
+        programs.push(json!({"identity":view.identity(),"modules":modules,"observations":observations,
+            "table_bytes":view.table().len(),"table_sha256":sha(view.table()),"source_bytes":0,"linked_binary_baseline":false}));
+    }
+    if observed.iter().any(|matched| !matched) {
+        return Err("explicit span did not match a checked program/region identity".into());
+    }
+    if fs::read(&args[0])? != parent
+        || fs::read(&args[1])? != sidecar
+        || fs::read(&args[3])? != span_sidecar
+    {
+        return Err("input changed during module/span observation".into());
+    }
+    serde_json::to_writer_pretty(
+        io::stdout().lock(),
+        &json!({"schema_version":1,"status":"physical_modules_and_selected_spans_verified",
+        "parent_rom_sha256":sha(&parent),"layout_sidecar_sha256":sha(&sidecar),"span_sidecar_sha256":sha(&span_sidecar),
+        "inputs_unchanged":true,"programs":programs,"source_bytes":0,"arm7_binary_baseline_complete":false,"task_complete":false}),
+    )?;
+    Ok(())
+}
