index 0000000..dc36296
--- /dev/null
+++ b/lib/src/rom/arm7_modules.rs
@@ -0,0 +1,154 @@
+//! Physical ARM7 module inputs and explicit ARMv4T span observations.
+//! These inputs are not analyzed modules and establish no executable/source coverage.
+use std::{error::Error, fmt, ops::Range};
+
+use serde::Serialize;
+use unarm::args::Argument;
+use unarm::{ArmVersion, Endian, Ins, ParseFlags, ParseMode, ParsedIns, Parser, arm, thumb};
+
+use super::arm7::{
+    Arm7RegionKind, Arm7View, Cpu, InstructionSet, Processor, ProgramIdentity, TargetPolicy,
+};
+use crate::config::symbol::InstructionMode;
+
+/// Full program, CPU and physical loader-region identity.
+#[derive(Debug, PartialEq, Eq, Serialize)]
+pub struct Arm7ModuleIdentity<'a> {
+    program: &'a ProgramIdentity,
+    cpu: Cpu,
+    region: Arm7RegionKind,
+}
+impl Arm7ModuleIdentity<'_> {
+    /// Both program hashes and its exact parent/NitroFS selector.
+    pub fn program(&self) -> &ProgramIdentity {
+        self.program
+    }
+    /// ARM7; construction is limited to checked ARM7 views.
+    pub fn cpu(&self) -> &Cpu {
+        &self.cpu
+    }
+    /// Startup or an original ordered autoload index.
+    pub fn region(&self) -> &Arm7RegionKind {
+        &self.region
+    }
+}
+
+/// Immutable physical input obtained only from a checked program view.
+#[derive(Debug)]
+pub struct Arm7ModuleInput<'a> {
+    identity: Arm7ModuleIdentity<'a>,
+    bytes: &'a [u8],
+    initialized: Range<u32>,
+    bss: Range<u32>,
+}
+
+impl Arm7View<'_> {
+    /// Physical startup/autoload inputs in loader order. The table is excluded.
+    pub fn module_inputs(&self) -> impl Iterator<Item = Arm7ModuleInput<'_>> {
+        let program = self.identity();
+        std::iter::once(self.startup()).chain(self.autoloads()).map(move |region| Arm7ModuleInput {
+            identity: Arm7ModuleIdentity {
+                program,
+                cpu: Cpu::Arm7,
+                region: region.description().kind.clone(),
+            },
+            bytes: region.bytes(),
+            initialized: region.description().runtime_base..region.bss_start(),
+            bss: region.bss_start()..region.bss_end(),
+        })
+    }
+}
+
+/// A rejected span yields no partial observations.
+#[derive(Debug, PartialEq, Eq)]
+pub enum DecodeSpanError {
+    EmptyOrReversed,
+    Bounds,
+    Alignment,
+    TruncatedInstruction { address: u32 },
+    IllegalInstruction { address: u32 },
+}
+impl fmt::Display for DecodeSpanError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "ARM7 span observation: {self:?}")
+    }
+}
+impl Error for DecodeSpanError {}
+
+impl Arm7ModuleInput<'_> {
+    /// Identity preserves program context even for equal payloads/addresses.
+    pub fn identity(&self) -> &Arm7ModuleIdentity<'_> {
+        &self.identity
+    }
+    /// Original initialized runtime range, without a code/data classification.
+    pub fn initialized(&self) -> Range<u32> {
+        self.initialized.clone()
+    }
+    /// Checked BSS runtime range.
+    pub fn bss(&self) -> Range<u32> {
+        self.bss.clone()
+    }
+    /// Original initialized bytes.
+    pub fn bytes(&self) -> &[u8] {
+        self.bytes
+    }
+    /// A description copy. Changing it cannot modify the internal decoder policy.
+    pub fn target(&self) -> TargetPolicy {
+        TargetPolicy { cpu: Cpu::Arm7, isa: InstructionSet::ArmV4T, processor: Processor::Arm7Tdmi }
+    }
+    /// Observe only an explicitly selected initialized span and ARM/Thumb mode.
+    ///
+    /// All requested bytes must decode completely under fixed ARMv4T policy.
+    /// This neither finds functions nor establishes that a span is executable.
+    pub fn decode_span(
+        &self,
+        mode: InstructionMode,
+        span: Range<u32>,
+    ) -> Result<Vec<(u32, Ins, ParsedIns)>, DecodeSpanError> {
+        if span.start >= span.end {
+            return Err(DecodeSpanError::EmptyOrReversed);
+        }
+        if span.start < self.initialized.start || span.end > self.initialized.end {
+            return Err(DecodeSpanError::Bounds);
+        }
+        let width = if mode == InstructionMode::Arm { 4 } else { 2 };
+        if !span.start.is_multiple_of(width) || !span.end.is_multiple_of(width) {
+            return Err(DecodeSpanError::Alignment);
+        }
+        let start = (span.start - self.initialized.start) as usize;
+        let end = (span.end - self.initialized.start) as usize;
+        let bytes = self.bytes.get(start..end).ok_or(DecodeSpanError::Bounds)?;
+        let flags = ParseFlags { version: ArmVersion::V4T, ual: false };
+        let parse_mode = if mode == InstructionMode::Arm {
+            ParseMode::Arm
+        } else {
+            ParseMode::Thumb
+        };
+        let mut parser = Parser::new(parse_mode, span.start, Endian::Little, flags, bytes);
+        let mut next_address = span.start;
+        let mut observations = Vec::new();
+        loop {
+            let Some((address, ins, parsed)) = parser.next() else {
+                if next_address != span.end {
+                    return Err(DecodeSpanError::TruncatedInstruction { address: next_address });
+                }
+                return Ok(observations);
+            };
+            let illegal = match ins {
+                Ins::Arm(ins) => ins.op == arm::Opcode::Illegal,
+                Ins::Thumb(ins) => {
+                    ins.op == thumb::Opcode::Illegal
+                        || (parser.address - address == 4 && ins.op != thumb::Opcode::Bl)
+                        || (ins.op == thumb::Opcode::Bl
+                            && !matches!(parsed.args[0], Argument::BranchDest(_)))
+                }
+                Ins::Data => true,
+            };
+            if illegal || parsed.mnemonic == "<illegal>" {
+                return Err(DecodeSpanError::IllegalInstruction { address });
+            }
+            next_address = parser.address;
+            observations.push((address, ins, parsed));
+        }
+    }
+}
