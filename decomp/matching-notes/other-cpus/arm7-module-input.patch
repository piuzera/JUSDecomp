@@ -0,0 +1,297 @@
+use unarm::{ArmVersion, ParseFlags, arm, thumb};
+
+#[test]
+fn locked_parser_distinguishes_v4t_and_explicit_legacy_v5te() {
+    let v4 = ParseFlags { version: ArmVersion::V4T, ual: false };
+    let v5 = ParseFlags { version: ArmVersion::V5Te, ual: false };
+    assert_eq!(arm::Ins::new(0xe12fff10, &v4).op, arm::Opcode::Bx);
+    assert_eq!(arm::Ins::new(0xe12fff30, &v4).op, arm::Opcode::Illegal);
+    assert_eq!(arm::Ins::new(0xe12fff30, &v5).op, arm::Opcode::BlxR);
+    assert_eq!(thumb::Ins::new(0x4750, &v4).op, thumb::Opcode::BxR);
+    assert_eq!(thumb::Ins::new(0x47d0, &v4).op, thumb::Opcode::Illegal);
+    assert_eq!(thumb::Ins::new(0x47d0, &v5).op, thumb::Opcode::BlxR);
+    assert_eq!(thumb::Ins::new(0xe800, &v4).op, thumb::Opcode::Illegal);
+    assert_ne!(thumb::Ins::new(0xe800, &v5).op, thumb::Opcode::Illegal);
+}
+
+use ds_decomp::{
+    config::symbol::InstructionMode,
+    rom::{
+        arm7::{Arm7Layout, Cpu, InstructionSet, Processor, ProgramSelector},
+        arm7_modules::DecodeSpanError,
+    },
+};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+
+fn sha(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn put(bytes: &mut [u8], offset: usize, value: u32) {
+    bytes[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+}
+struct Fixture {
+    parent: Vec<u8>,
+    parent_layout: Arm7Layout,
+    child_layout: Arm7Layout,
+}
+impl Fixture {
+    fn new(code: &[u8]) -> Self {
+        let base = 0x02380000u32;
+        let mut image = vec![0; 120];
+        image[..code.len()].copy_from_slice(code);
+        for (index, value) in
+            [base + 96, base + 120, base + 64, base + 64, base + 64].into_iter().enumerate()
+        {
+            put(&mut image, 32 + index * 4, value);
+        }
+        for (index, value) in [0x037f8000, 16, 8, 0x027e0000, 16, 4].into_iter().enumerate() {
+            put(&mut image, 96 + index * 4, value);
+        }
+        fn program(size: usize, image: &[u8]) -> Vec<u8> {
+            let mut bytes = vec![0; size];
+            for (index, value) in
+                [0x4000, 0x02380000, 0x02380000, image.len() as u32].into_iter().enumerate()
+            {
+                put(&mut bytes, 0x30 + index * 4, value);
+            }
+            bytes[0x4000..0x4078].copy_from_slice(image);
+            bytes
+        }
+        let child = program(0x5000, &image);
+        let mut parent = program(0xf000, &image);
+        parent[0x8000..0xd000].copy_from_slice(&child);
+        for (index, value) in [0x5000, 49, 0x5100, 16].into_iter().enumerate() {
+            put(&mut parent, 0x40 + index * 4, value);
+        }
+        put(&mut parent, 0x5000, 16);
+        parent[0x5006..0x5008].copy_from_slice(&2u16.to_le_bytes());
+        put(&mut parent, 0x5008, 28);
+        parent[0x500e..0x5010].copy_from_slice(&0xf000u16.to_le_bytes());
+        parent[0x5010..0x501c].copy_from_slice(b"\x88ChildRom\x01\xf0\0");
+        parent[0x501c..0x5031].copy_from_slice(b"\x0apublic.srl\x08copy.srl\0");
+        for offset in [0x5100, 0x5108] {
+            put(&mut parent, offset, 0x8000);
+            put(&mut parent, offset + 4, 0xd000);
+        }
+        let layout = |program_sha, selector, header_sha| {
+            serde_json::from_value(json!({
+            "identity":{"parent_rom_sha256":sha(&parent),"program":selector,"program_sha256":program_sha},
+            "target":{"cpu":"arm7","isa":"armv4t","processor":"arm7tdmi"},"header_sha256":header_sha,
+            "image_offset":0x4000,"image_bytes":120,"image_sha256":sha(&image),"base":base,"entry":base,
+            "params_offset":32,"params_sha256":sha(&image[32..52]),"table_extent":{"start":96,"end":120},"table_sha256":sha(&image[96..]),
+            "regions":[
+                {"kind":"startup","stored_extent":{"start":0,"end":64},"runtime_base":base,"bss_bytes":0,"sha256":sha(&image[..64])},
+                {"kind":{"autoload":0},"stored_extent":{"start":64,"end":80},"runtime_base":0x037f8000,"bss_bytes":8,"sha256":sha(&image[64..80])},
+                {"kind":{"autoload":1},"stored_extent":{"start":80,"end":96},"runtime_base":0x027e0000,"bss_bytes":4,"sha256":sha(&image[80..96])}
+            ]
+        })).unwrap()
+        };
+        let parent_layout = layout(sha(&parent), json!({"kind":"parent"}), sha(&parent[..0x4000]));
+        let child_layout = layout(
+            sha(&child),
+            json!({"kind":"nitro_fs","path":"ChildRom/public.srl"}),
+            sha(&child[..0x4000]),
+        );
+        Self { parent, parent_layout, child_layout }
+    }
+}
+
+#[test]
+fn checked_descriptors_preserve_physical_ranges_and_exclude_table() {
+    let f = Fixture::new(&[0x10, 0xff, 0x2f, 0xe1]);
+    let view = f.parent_layout.checked(&f.parent).unwrap();
+    let modules: Vec<_> = view.module_inputs().collect();
+    assert_eq!(modules.len(), 3);
+    assert_eq!(modules[0].initialized(), 0x02380000..0x02380040);
+    assert_eq!(modules[0].bss(), 0x02380040..0x02380040);
+    assert_eq!(modules[1].initialized(), 0x037f8000..0x037f8010);
+    assert_eq!(modules[1].bss(), 0x037f8010..0x037f8018);
+    assert_eq!(modules[2].initialized(), 0x027e0000..0x027e0010);
+    assert_eq!(modules[2].bss(), 0x027e0010..0x027e0014);
+    assert_eq!(modules.iter().map(|m| m.bytes().len()).sum::<usize>() + view.table().len(), 120);
+    for module in modules {
+        let target = module.target();
+        assert_eq!(target.cpu, Cpu::Arm7);
+        assert_eq!(target.isa, InstructionSet::ArmV4T);
+        assert_eq!(target.processor, Processor::Arm7Tdmi);
+    }
+}
+
+#[test]
+fn equal_payloads_keep_parent_child_and_exact_path_identities_distinct() {
+    let f = Fixture::new(&[0x10, 0xff, 0x2f, 0xe1]);
+    let parent = f.parent_layout.checked(&f.parent).unwrap();
+    let child = f.child_layout.checked(&f.parent).unwrap();
+    let mut copy_layout = f.child_layout.clone();
+    copy_layout.identity.program = ProgramSelector::NitroFs { path: "ChildRom/copy.srl".into() };
+    let copy = copy_layout.checked(&f.parent).unwrap();
+    let a = parent.module_inputs().next().unwrap();
+    let b = child.module_inputs().next().unwrap();
+    let c = copy.module_inputs().next().unwrap();
+    assert_eq!(a.bytes(), b.bytes());
+    assert_eq!(b.bytes(), c.bytes());
+    assert_ne!(a.identity(), b.identity());
+    assert_ne!(b.identity(), c.identity());
+    assert_ne!(
+        parent.module_inputs().next().unwrap().identity(),
+        parent.module_inputs().nth(1).unwrap().identity()
+    );
+}
+
+#[test]
+fn explicit_arm_and_thumb_spans_decode_v4t_including_thumb_halfword_alignment() {
+    for (bytes, mode, span, count) in [
+        (vec![0x10, 0xff, 0x2f, 0xe1], InstructionMode::Arm, 0x02380000..0x02380004, 1),
+        (vec![0, 0, 0x50, 0x47], InstructionMode::Thumb, 0x02380002..0x02380004, 1),
+        (vec![0x99, 0xf0, 0x66, 0xf8], InstructionMode::Thumb, 0x02380000..0x02380004, 1),
+    ] {
+        let f = Fixture::new(&bytes);
+        let view = f.parent_layout.checked(&f.parent).unwrap();
+        let module = view.module_inputs().next().unwrap();
+        let out = module.decode_span(mode, span.clone()).unwrap();
+        assert_eq!(out.len(), count);
+        assert_eq!(out[0].0, span.start);
+    }
+}
+
+#[test]
+fn v5_only_instructions_reject_atomically_even_after_valid_prefix() {
+    for (bytes, mode, bad_address) in [
+        (vec![0x10, 0xff, 0x2f, 0xe1, 0x30, 0xff, 0x2f, 0xe1], InstructionMode::Arm, 0x02380004),
+        (vec![0x50, 0x47, 0xd0, 0x47], InstructionMode::Thumb, 0x02380002),
+        (vec![0, 0xf0, 0, 0xe8], InstructionMode::Thumb, 0x02380000),
+    ] {
+        let f = Fixture::new(&bytes);
+        let view = f.parent_layout.checked(&f.parent).unwrap();
+        let module = view.module_inputs().next().unwrap();
+        assert_eq!(
+            module.decode_span(mode, 0x02380000..0x02380000 + bytes.len() as u32).unwrap_err(),
+            DecodeSpanError::IllegalInstruction { address: bad_address }
+        );
+    }
+}
+
+#[test]
+fn trailing_thumb_bl_and_wrong_second_half_do_not_publish_partial_observation() {
+    for bytes in
+        [vec![0, 0xf0], vec![0x50, 0x47, 0, 0xf0], vec![0, 0xf0, 0x50, 0x47], vec![0, 0xf8]]
+    {
+        let f = Fixture::new(&bytes);
+        let view = f.parent_layout.checked(&f.parent).unwrap();
+        let module = view.module_inputs().next().unwrap();
+        assert!(
+            module
+                .decode_span(InstructionMode::Thumb, 0x02380000..0x02380000 + bytes.len() as u32)
+                .is_err()
+        );
+    }
+}
+
+#[test]
+fn span_alignment_bounds_order_and_table_reject_without_panics() {
+    let f = Fixture::new(&[0x10, 0xff, 0x2f, 0xe1]);
+    let view = f.parent_layout.checked(&f.parent).unwrap();
+    let module = view.module_inputs().next().unwrap();
+    for span in [
+        0x02380000..0x02380000,
+        std::ops::Range { start: 0x02380004, end: 0x02380000 },
+        0x02380001..0x02380005,
+        0x02380002..0x02380006,
+        0x02380000..0x02380006,
+        0x0237fffc..0x02380004,
+        0x0238003c..0x02380044,
+        0x02380060..0x02380078,
+        0xfffffffc..u32::MAX,
+    ] {
+        assert!(matches!(
+            std::panic::catch_unwind(|| module.decode_span(InstructionMode::Arm, span.clone())),
+            Ok(Err(_))
+        ));
+    }
+    let autoload = view.module_inputs().nth(1).unwrap();
+    assert!(autoload.decode_span(InstructionMode::Arm, 0x037f8010..0x037f8018).is_err());
+    assert!(autoload.decode_span(InstructionMode::Arm, 0x027e0000..0x027e0004).is_err());
+}
+
+#[test]
+fn returned_target_copy_cannot_change_internal_isa_policy() {
+    let f = Fixture::new(&[0x30, 0xff, 0x2f, 0xe1]);
+    let view = f.parent_layout.checked(&f.parent).unwrap();
+    let module = view.module_inputs().next().unwrap();
+    let mut target = module.target();
+    target.cpu = Cpu::Arm9;
+    target.isa = InstructionSet::ArmV5Te;
+    target.processor = Processor::Arm946E;
+    assert_eq!(target.cpu, Cpu::Arm9);
+    assert_eq!(module.target().cpu, Cpu::Arm7);
+    assert!(matches!(
+        module.decode_span(InstructionMode::Arm, 0x02380000..0x02380004),
+        Err(DecodeSpanError::IllegalInstruction { .. })
+    ));
+}
