+#[test]
+fn existing_function_parser_keeps_explicit_v5te_and_blx_support() {
+    use ds_decomp::analysis::functions::{Function, FunctionParseOptions, ParseFunctionOptions};
+    const BASE: u32 = 0x02000000;
+    let bytes: Vec<_> = [0xe92d4010u32, 0xe3a00000, 0xe12fff30, 0xe8bd8010]
+        .into_iter()
+        .flat_map(u32::to_le_bytes)
+        .collect();
+    let function = Function::parse_function(FunctionParseOptions {
+        name: "public_arm9_blx".into(),
+        start_address: BASE,
+        base_address: BASE,
+        module_code: &bytes,
+        module_start_address: BASE,
+        module_end_address: BASE + bytes.len() as u32,
+        parse_options: ParseFunctionOptions { thumb: Some(false) },
+        ..Default::default()
+    })
+    .unwrap();
+    let parser = function.parser(&bytes, BASE);
+    assert_eq!(parser.flags.version, ArmVersion::V5Te);
+    assert!(parser.into_iter().any(|(_, _, parsed)| parsed.mnemonic == "blx"));
+}
