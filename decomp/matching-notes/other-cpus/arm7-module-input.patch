+#[test]
+fn combined_thumb_bl_consumes_four_bytes_and_preserves_next_address() {
+    use unarm::args::Argument;
+    let f = Fixture::new(&[0x99, 0xf0, 0x66, 0xf8, 0x50, 0x47]);
+    let view = f.parent_layout.checked(&f.parent).unwrap();
+    let module = view.module_inputs().next().unwrap();
+    let out = module.decode_span(InstructionMode::Thumb, 0x02380000..0x02380006).unwrap();
+    assert_eq!(out.len(), 2);
+    assert_eq!(out[0].0, 0x02380000);
+    assert_eq!(out[1].0, 0x02380004);
+    assert_eq!(out[0].2.mnemonic, "bl");
+    assert_eq!(out[0].2.args[0], Argument::BranchDest(0x990d0));
+    assert_eq!(out[1].2.mnemonic, "bx");
+}
