+#[test]
+fn trailing_thumb_bl_reports_first_unobserved_byte_without_partial_success() {
+    for (bytes, address) in [(vec![0, 0xf0], 0x02380000), (vec![0x50, 0x47, 0, 0xf0], 0x02380002)] {
+        let f = Fixture::new(&bytes);
+        let view = f.parent_layout.checked(&f.parent).unwrap();
+        let module = view.module_inputs().next().unwrap();
+        assert_eq!(
+            module
+                .decode_span(InstructionMode::Thumb, 0x02380000..0x02380000 + bytes.len() as u32)
+                .unwrap_err(),
+            DecodeSpanError::TruncatedInstruction { address }
+        );
+    }
