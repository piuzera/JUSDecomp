+use ds_decomp::rom::arm7::Arm7Layout;
+use serde_json::json;
+use sha2::{Digest, Sha256};
+
+fn sha(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn put(bytes: &mut [u8], offset: usize, value: u32) {
+    bytes[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+}
+pub struct Fixture {
+    pub parent: Vec<u8>,
+    pub parent_layout: Arm7Layout,
+    pub child_layout: Arm7Layout,
+}
+impl Fixture {
+    pub fn new(code: &[u8]) -> Self {
+        Self::at(code, 0x02380000, 0x037f8000)
+    }
+    pub fn at(code: &[u8], base: u32, autoload_base: u32) -> Self {
+        let mut image = vec![0; 120];
+        image[..code.len()].copy_from_slice(code);
+        for (index, value) in
+            [base + 96, base + 120, base + 64, base + 64, base + 64].into_iter().enumerate()
+        {
+            put(&mut image, 32 + index * 4, value);
+        }
+        for (index, value) in [autoload_base, 16, 8, 0x027e0000, 16, 4].into_iter().enumerate() {
+            put(&mut image, 96 + index * 4, value);
+        }
+        fn program(size: usize, image: &[u8], base: u32) -> Vec<u8> {
+            let mut bytes = vec![0; size];
+            for (index, value) in [0x4000, base, base, image.len() as u32].into_iter().enumerate() {
+                put(&mut bytes, 0x30 + index * 4, value);
+            }
+            bytes[0x4000..0x4078].copy_from_slice(image);
+            bytes
+        }
+        let child = program(0x5000, &image, base);
+        let mut parent = program(0xf000, &image, base);
+        parent[0x8000..0xd000].copy_from_slice(&child);
+        for (index, value) in [0x5000, 49, 0x5100, 16].into_iter().enumerate() {
+            put(&mut parent, 0x40 + index * 4, value);
+        }
+        put(&mut parent, 0x5000, 16);
+        parent[0x5006..0x5008].copy_from_slice(&2u16.to_le_bytes());
+        put(&mut parent, 0x5008, 28);
+        parent[0x500e..0x5010].copy_from_slice(&0xf000u16.to_le_bytes());
+        parent[0x5010..0x501c].copy_from_slice(b"\x88ChildRom\x01\xf0\0");
+        parent[0x501c..0x5031].copy_from_slice(b"\x0apublic.srl\x08copy.srl\0");
+        for offset in [0x5100, 0x5108] {
+            put(&mut parent, offset, 0x8000);
+            put(&mut parent, offset + 4, 0xd000);
+        }
+        let layout = |program_sha, selector, header_sha| {
+            serde_json::from_value(json!({
+            "identity":{"parent_rom_sha256":sha(&parent),"program":selector,"program_sha256":program_sha},
+            "target":{"cpu":"arm7","isa":"armv4t","processor":"arm7tdmi"},"header_sha256":header_sha,
+            "image_offset":0x4000,"image_bytes":120,"image_sha256":sha(&image),"base":base,"entry":base,
+            "params_offset":32,"params_sha256":sha(&image[32..52]),"table_extent":{"start":96,"end":120},"table_sha256":sha(&image[96..]),
+            "regions":[
+                {"kind":"startup","stored_extent":{"start":0,"end":64},"runtime_base":base,"bss_bytes":0,"sha256":sha(&image[..64])},
+                {"kind":{"autoload":0},"stored_extent":{"start":64,"end":80},"runtime_base":autoload_base,"bss_bytes":8,"sha256":sha(&image[64..80])},
+                {"kind":{"autoload":1},"stored_extent":{"start":80,"end":96},"runtime_base":0x027e0000,"bss_bytes":4,"sha256":sha(&image[80..96])}
+            ]
+        })).unwrap()
+        };
+        let parent_layout = layout(sha(&parent), json!({"kind":"parent"}), sha(&parent[..0x4000]));
+        let child_layout = layout(
+            sha(&child),
+            json!({"kind":"nitro_fs","path":"ChildRom/public.srl"}),
+            sha(&child[..0x4000]),
+        );
+        Self { parent, parent_layout, child_layout }
+    }
+}
