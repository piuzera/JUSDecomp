+//! Bounded ARMv4T observations of checked physical inputs, without function discovery.
+use crate::{
+    config::symbol::InstructionMode,
+    rom::{
+        arm7::TargetPolicy,
+        arm7_modules::{Arm7ModuleIdentity, Arm7ModuleInput, DecodeSpanError},
+    },
+};
+use serde::Serialize;
+use std::{error::Error, fmt, ops::Range};
+use unarm::{
+    ArmVersion, DisplayOptions, Ins, ParseFlags,
+    args::{Argument, Register},
+    arm, thumb,
+};
+
+/// Initialized bytes to interpret in one explicit mode, without an entrypoint claim.
+#[derive(Debug, Serialize)]
+pub struct Selection {
+    pub span: Range<u32>,
+    pub mode: InstructionMode,
+}
+/// Complete, immutable interpretation of a selected span under fixed ARMv4T.
+///
+/// Executability is unknown for the source span and every transfer target.
+/// Stored text and serialization do not reconstruct a parser or change ISA.
+#[derive(Debug, Serialize)]
+pub struct SpanObservation<'a> {
+    identity: &'a Arm7ModuleIdentity<'a>,
+    target: TargetPolicy,
+    selection: Selection,
+    executability: Executability,
+    instructions: Vec<InstructionObservation>,
+    transfers: Vec<TransferObservation<'a>>,
+}
+#[derive(Debug, Serialize)]
+pub struct InstructionObservation {
+    address: u32,
+    byte_len: u8,
+    text: String,
+    condition: Option<String>,
+}
+/// A possible transfer if this instruction executes, not evidence of reachability.
+#[derive(Debug, Serialize)]
+pub struct TransferObservation<'a> {
+    source: u32,
+    kind: TransferKind,
+    guard: TransferGuard,
+    target: Target<'a>,
+}
+#[derive(Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Executability {
+    Unknown,
+}
+#[derive(Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum TransferKind {
+    Branch,
+    Call,
+    Fallthrough,
+    CallContinuation,
+    Exchange,
+    PcWrite,
+    Exception,
+}
+#[derive(Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum TransferGuard {
+    Always,
+    /// The source instruction's recorded condition holds.
+    ConditionPassed,
+    /// The source instruction's recorded condition does not hold.
+    ConditionFailed,
+    /// Continuation only if the unconditionally invoked call returns.
+    CallReturned,
+    /// Continuation only if the call was taken and then returns.
+    ConditionPassedAndCallReturned,
+}
+#[derive(Debug, Serialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+pub enum Target<'a> {
+    Address {
+        address: u32,
+        /// Mode required by this transfer, not an independently known target mode.
+        mode: InstructionMode,
+        mapping: Mapping<'a>,
+        boundary: ObservationBoundary,
+    },
+    /// Destination address and mode remain unknown, including state-restoring writes.
+    Unknown,
+}
+/// Byte ownership in the supplied context; none of these variants proves execution.
+#[derive(Debug, Serialize)]
+#[serde(tag = "kind", content = "identity", rename_all = "snake_case")]
+pub enum Mapping<'a> {
+    Initialized(&'a Arm7ModuleIdentity<'a>),
+    Bss(&'a Arm7ModuleIdentity<'a>),
+    UnresolvedBytes,
+}
+#[derive(Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ObservationBoundary {
+    InstructionStart,
+    InstructionInterior,
+    OutsideSelection,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum ObservationError {
+    Decode(DecodeSpanError),
+    ForeignProgram,
+    MissingSource,
+    DuplicateOrOverlappingMapping,
+}
+impl fmt::Display for ObservationError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "ARM7 observation: {self:?}")
+    }
+}
+impl Error for ObservationError {}
+/// Observe every instruction in the selected initialized span atomically.
+///
+/// The context must contain the source and only checked modules from its exact
+/// program and CPU. Omitted mappings remain unresolved. Numeric targets share
+/// one classifier; no transfer triggers recursive decoding or function discovery.
+/// The selected end bounds decoding only and is never a discovered function end.
+pub fn observe<'a>(
+    source: &'a Arm7ModuleInput<'a>,
+    selection: Selection,
+    modules: &'a [Arm7ModuleInput<'a>],
+) -> Result<SpanObservation<'a>, ObservationError> {
+    for (index, module) in modules.iter().enumerate() {
+        if module.identity().program() != source.identity().program()
+            || module.identity().cpu() != source.identity().cpu()
+        {
+            return Err(ObservationError::ForeignProgram);
+        }
+        let extent = module.initialized().start..module.bss().end;
+        if modules[..index].iter().any(|prior| {
+            prior.identity() == module.identity()
+                || (prior.initialized().start < extent.end && extent.start < prior.bss().end)
+        }) {
+            return Err(ObservationError::DuplicateOrOverlappingMapping);
+        }
+    }
+    if !modules.iter().any(|module| {
+        module.identity() == source.identity()
+            && module.initialized() == source.initialized()
+            && module.bss() == source.bss()
+            && module.bytes() == source.bytes()
+    }) {
+        return Err(ObservationError::MissingSource);
+    }
+    let decoded = source
+        .decode_span(selection.mode, selection.span.clone())
+        .map_err(ObservationError::Decode)?;
+    let starts: Vec<_> = decoded.iter().map(|(address, _, _)| *address).collect();
+    let destination = |address| {
+        let mapping = modules
+            .iter()
+            .find_map(|module| {
+                if module.initialized().contains(&address) {
+                    Some(Mapping::Initialized(module.identity()))
+                } else if module.bss().contains(&address) {
+                    Some(Mapping::Bss(module.identity()))
+                } else {
+                    None
+                }
+            })
+            .unwrap_or(Mapping::UnresolvedBytes);
+        let boundary = if !selection.span.contains(&address) {
+            ObservationBoundary::OutsideSelection
+        } else if starts.binary_search(&address).is_ok() {
+            ObservationBoundary::InstructionStart
+        } else {
+            ObservationBoundary::InstructionInterior
+        };
+        Target::Address { address, mode: selection.mode, mapping, boundary }
+    };
+    let flags = ParseFlags { version: ArmVersion::V4T, ual: false };
+    let mut instructions = Vec::with_capacity(decoded.len());
+    let mut transfers = Vec::new();
+    for (index, (address, ins, parsed)) in decoded.iter().enumerate() {
+        let next = starts.get(index + 1).copied().unwrap_or(selection.span.end);
+        let mut parsed = parsed.clone();
+        // unarm 1.9.2 truncates ARM displacements and applies Thumb BL's PC
+        // bias before sign extension. Normalize every direct branch from bytes.
+        let branch_offset = match ins {
+            Ins::Arm(ins) if matches!(ins.op, arm::Opcode::B | arm::Opcode::Bl) => {
+                Some(((ins.code << 8) as i32 >> 6) + 8)
+            }
+            Ins::Thumb(ins) => match ins.op {
+                thumb::Opcode::B => Some(((ins.code << 24) as i32 >> 23) + 4),
+                thumb::Opcode::BLong => Some(((ins.code << 21) as i32 >> 20) + 4),
+                thumb::Opcode::Bl => {
+                    // Complete-span decoding already validated both halfwords.
+                    let offset = (address - source.initialized().start) as usize;
+                    let bytes = source.bytes();
+                    let prefix = u16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as u32;
+                    Some(((prefix << 21) as i32 >> 9) + ((ins.code & 0x7ff) << 1) as i32 + 4)
+                }
+                _ => None,
+            },
+            _ => None,
+        };
+        if let Some(offset) = branch_offset {
+            parsed.args[0] = Argument::BranchDest(offset);
+        }
+        let (condition, defs, exchange, exception, call) = match ins {
+            Ins::Arm(ins) => (
+                ins.is_conditional()
+                    .then(|| format!("{:?}", ins.modifier_cond()).to_ascii_lowercase()),
+                ins.defs(&flags),
+                ins.op == arm::Opcode::Bx,
+                ins.op == arm::Opcode::Swi,
+                ins.op == arm::Opcode::Bl,
+            ),
+            Ins::Thumb(ins) => (
+                ins.is_conditional()
+                    .then(|| format!("{:?}", ins.modifier_cond()).to_ascii_lowercase()),
+                ins.defs(&flags),
+                ins.op == thumb::Opcode::BxR,
+                ins.op == thumb::Opcode::Swi,
+                ins.op == thumb::Opcode::Bl,
+            ),
+            Ins::Data => unreachable!("checked instruction decoding excludes data"),
+        };
+        let conditional = condition.is_some();
+        instructions.push(InstructionObservation {
+            address: *address,
+            byte_len: (next - address) as u8,
+            text: parsed.display(DisplayOptions::default()).to_string(),
+            condition,
+        });
+        let mut emit = |kind, guard, target| {
+            transfers.push(TransferObservation { source: *address, kind, guard, target });
+        };
+        let taken = if conditional {
+            TransferGuard::ConditionPassed
+        } else {
+            TransferGuard::Always
+        };
+        if let Some(offset) = branch_offset {
+            emit(
+                if call { TransferKind::Call } else { TransferKind::Branch },
+                taken,
+                destination(address.wrapping_add_signed(offset)),
+            );
+            if call {
+                emit(
+                    TransferKind::CallContinuation,
+                    if conditional {
+                        TransferGuard::ConditionPassedAndCallReturned
+                    } else {
+                        TransferGuard::CallReturned
+                    },
+                    destination(next),
+                );
+            }
+            if conditional {
+                emit(TransferKind::Fallthrough, TransferGuard::ConditionFailed, destination(next));
+            }
+        } else {
+            let writes_pc = defs.iter().any(|arg| match arg {
+                Argument::Reg(reg) => reg.reg == Register::Pc,
+                Argument::RegList(list) => list.regs & (1 << Register::Pc as u8) != 0,
+                _ => false,
+            });
+            if exchange || exception || writes_pc {
+                let kind = if exchange {
+                    TransferKind::Exchange
+                } else if exception {
+                    TransferKind::Exception
+                } else {
+                    TransferKind::PcWrite
+                };
+                emit(kind, taken, Target::Unknown);
+                if conditional {
+                    emit(
+                        TransferKind::Fallthrough,
+                        TransferGuard::ConditionFailed,
+                        destination(next),
+                    );
+                }
+            } else {
+                emit(TransferKind::Fallthrough, TransferGuard::Always, destination(next));
+            }
+        }
+    }
+    Ok(SpanObservation {
+        identity: source.identity(),
+        target: source.target(),
+        selection,
+        executability: Executability::Unknown,
+        instructions,
+        transfers,
+    })
+}
+
+impl SpanObservation<'_> {
+    pub fn identity(&self) -> &Arm7ModuleIdentity<'_> {
+        self.identity
+    }
+    pub fn target(&self) -> &TargetPolicy {
+        &self.target
+    }
+    pub fn selection(&self) -> &Selection {
+        &self.selection
+    }
+    pub fn executability(&self) -> &Executability {
+        &self.executability
+    }
+    pub fn instructions(&self) -> &[InstructionObservation] {
+        &self.instructions
+    }
+    pub fn transfers(&self) -> &[TransferObservation<'_>] {
+        &self.transfers
+    }
+}
+impl InstructionObservation {
+    pub fn address(&self) -> u32 {
+        self.address
+    }
+    pub fn byte_len(&self) -> u8 {
+        self.byte_len
+    }
+    /// Stored assembly text; direct operands are signed offsets from this address.
+    pub fn text(&self) -> &str {
+        &self.text
+    }
+    pub fn condition(&self) -> Option<&str> {
+        self.condition.as_deref()
+    }
+}
+impl TransferObservation<'_> {
+    pub fn source(&self) -> u32 {
+        self.source
+    }
+    pub fn kind(&self) -> &TransferKind {
+        &self.kind
+    }
+    pub fn guard(&self) -> &TransferGuard {
+        &self.guard
+    }
+    pub fn target(&self) -> &Target<'_> {
+        &self.target
+    }
+}
