+//! Read-only bounded ARM7 observations selected by independently pinned manifests.
+use ds_decomp::{
+    analysis::arm7_observation::{Selection, observe},
+    config::symbol::InstructionMode,
+    rom::arm7::{Arm7Layout, Arm7RegionKind, ProgramIdentity},
+};
+use serde::Deserialize;
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::{error::Error, fs, io, ops::Range};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SelectedSpan {
+    program: ProgramIdentity,
+    region: Arm7RegionKind,
+    mode: InstructionMode,
+    extent: Range<u32>,
+}
+fn sha(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn main() -> Result<(), Box<dyn Error>> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args.len() != 5 {
+        return Err(
+            "usage: arm7_observation_probe ROM LAYOUT_JSON LAYOUT_SHA256 SPANS_JSON SPANS_SHA256"
+                .into(),
+        );
+    }
+    let parent = fs::read(&args[0])?;
+    let sidecar = fs::read(&args[1])?;
+    let span_sidecar = fs::read(&args[3])?;
+    if sha(&sidecar) != args[2] || sha(&span_sidecar) != args[4] {
+        return Err("independent layout/span sidecar hash mismatch".into());
+    }
+    let layouts: Vec<Arm7Layout> = serde_json::from_slice(&sidecar)?;
+    let spans: Vec<SelectedSpan> = serde_json::from_slice(&span_sidecar)?;
+    if layouts.is_empty() || spans.is_empty() {
+        return Err("no physical layouts or explicit span observations supplied".into());
+    }
+    let mut programs = Vec::new();
+    let mut observed = vec![false; spans.len()];
+    for layout in layouts {
+        let view = layout.checked(&parent)?;
+        let modules: Vec<_> = view.module_inputs().collect();
+        let mut observations = Vec::new();
+        for module in &modules {
+            for (index, span) in spans.iter().enumerate() {
+                if module.identity().program() != &span.program
+                    || module.identity().region() != &span.region
+                {
+                    continue;
+                }
+                if observed[index] {
+                    return Err("span identity matched more than one selected module".into());
+                }
+                observations.push(observe(
+                    module,
+                    Selection { span: span.extent.clone(), mode: span.mode },
+                    &modules,
+                )?);
+                observed[index] = true;
+            }
+        }
+        programs.push(json!({"identity":view.identity(),"observations":observations}));
+    }
+    if observed.iter().any(|matched| !matched) {
+        return Err("explicit span did not match a checked program/region identity".into());
+    }
+    if fs::read(&args[0])? != parent
+        || fs::read(&args[1])? != sidecar
+        || fs::read(&args[3])? != span_sidecar
+    {
+        return Err("input changed during bounded observation".into());
+    }
+    serde_json::to_writer_pretty(
+        io::stdout().lock(),
+        &json!({"schema_version":1,"status":"bounded_arm7_observations_verified",
+            "parent_rom_sha256":sha(&parent),"layout_sidecar_sha256":sha(&sidecar),
+            "span_sidecar_sha256":sha(&span_sidecar),"inputs_unchanged":true,
+            "programs":programs,"source_bytes":0,"arm7_binary_baseline_complete":false,
+            "function_extents_established":false,"executable_coverage_established":false}),
+    )?;
+    Ok(())
+}
