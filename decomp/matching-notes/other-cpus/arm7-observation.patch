+mod common;
+use common::Fixture;
+use ds_decomp::{
+    analysis::arm7_observation::{ObservationError, Selection, observe},
+    config::symbol::InstructionMode::{Arm, Thumb},
+    rom::{arm7::ProgramSelector, arm7_modules::DecodeSpanError},
+};
+use serde_json::{Value, json};
+const BASE: u32 = 0x02380000;
+fn arm_bytes(words: &[u32]) -> Vec<u8> {
+    words.iter().flat_map(|w| w.to_le_bytes()).collect()
+}
+fn branch(from: u32, to: u32, link: bool, condition: u32) -> u32 {
+    condition << 28
+        | if link { 0x0b000000 } else { 0x0a000000 }
+        | (to.wrapping_sub(from).wrapping_sub(8) >> 2 & 0xffffff)
+}
+fn report(bytes: &[u8], mode: ds_decomp::config::symbol::InstructionMode) -> Value {
+    let f = Fixture::new(bytes);
+    let view = f.parent_layout.checked(&f.parent).unwrap();
+    let modules: Vec<_> = view.module_inputs().collect();
+    serde_json::to_value(
+        observe(&modules[0], Selection { span: BASE..BASE + bytes.len() as u32, mode }, &modules)
+            .unwrap(),
+    )
+    .unwrap()
+}
+#[test]
+fn observations_store_complete_span_text_identity_and_fixed_policy() {
+    let value = report(&arm_bytes(&[0xe1a00000, 0xe1a01001]), Arm);
+    assert_eq!(value["target"], json!({"cpu":"arm7","isa":"armv4t","processor":"arm7tdmi"}));
+    assert_eq!(value["executability"], "unknown");
+    assert_eq!(value["identity"]["cpu"], "arm7");
+    assert_eq!(value["identity"]["program"]["program"]["kind"], "parent");
+    assert_eq!(value["selection"]["span"], json!({"start":BASE,"end":BASE+8}));
+    assert_eq!(value["instructions"].as_array().unwrap().len(), 2);
+    assert_eq!(value["instructions"][0]["text"], "mov r0, r0");
+    assert_eq!(value["instructions"][0]["byte_len"], 4);
+    assert_eq!(value["transfers"][1]["target"]["boundary"], "outside_selection");
+    assert_eq!(value["transfers"][1]["target"]["address"], BASE + 8);
+}
+#[test]
+fn isa_rejection_and_truncated_thumb_bl_are_atomic() {
+    for (bytes, mode, error) in [
+        (
+            arm_bytes(&[0xe1a00000, 0xe12fff30]),
+            Arm,
+            DecodeSpanError::IllegalInstruction { address: BASE + 4 },
+        ),
+        (
+            vec![0x50, 0x47, 0xd0, 0x47],
+            Thumb,
+            DecodeSpanError::IllegalInstruction { address: BASE + 2 },
+        ),
+        (vec![0, 0xf0, 0, 0xe8], Thumb, DecodeSpanError::IllegalInstruction { address: BASE }),
+        (
+            vec![0x50, 0x47, 0, 0xf0],
