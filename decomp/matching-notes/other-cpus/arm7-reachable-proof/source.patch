+#[test]
+fn witness_views_keep_guarded_terminal_edge_and_bounded_counts() {
+    let f = Fixture::new(&bytes(&[0xe1a00000, 0xbafffffd]));
+    let v = f.parent_layout.checked(&f.parent).unwrap();
+    let m: Vec<_> = v.module_inputs().collect();
+    let o = [observe(&m[0], Selection { span: BASE..BASE + 8, mode: Arm }, &m).unwrap()];
+    let graph = connect(&o, &[root(&o[0], BASE)]).unwrap();
+    assert_eq!(graph.program(), o[0].identity().program());
+    let selected = graph.roots().next().unwrap();
+    assert_eq!(selected.visit_count(), graph.node_count());
+    assert_eq!(selected.edge_examinations(), graph.edge_count());
+    assert_eq!(selected.request().address, BASE);
+    let frontier = selected.frontiers().next().unwrap();
+    assert_eq!(format!("{:?}", frontier.reason()), "OutsideSelection");
+    let witness = frontier.witness().unwrap();
+    assert_eq!(witness.iter().map(|t| t.source()).collect::<Vec<_>>(), [BASE, BASE + 4]);
+    assert_eq!(format!("{:?}", witness[1].guard()), "ConditionFailed");
+    assert!(witness.len() <= graph.node_count());
+}
