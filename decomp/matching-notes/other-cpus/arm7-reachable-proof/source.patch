index 0000000..22c24da
--- /dev/null
+++ b/lib/examples/arm7_reachable_probe.rs
@@ -0,0 +1,121 @@
+//! Read-only selected ARM7 candidate graphs with independently pinned inputs/producer.
+use ds_decomp::{
+    analysis::{
+        arm7_observation::{Selection, observe},
+        arm7_reachable::{RootRequest, connect},
+    },
+    config::symbol::InstructionMode,
+    rom::arm7::{Arm7Layout, Arm7RegionKind, ProgramIdentity},
+};
+use serde::Deserialize;
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::{error::Error, fs, io, ops::Range};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SelectedSpan {
+    region: Arm7RegionKind,
+    mode: InstructionMode,
+    extent: Range<u32>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SelectedRoot {
+    selection: usize,
+    address: u32,
+    assumption: String,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProgramRequest {
+    program: ProgramIdentity,
+    selections: Vec<SelectedSpan>,
+    roots: Vec<SelectedRoot>,
+}
+fn sha(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn main() -> Result<(), Box<dyn Error>> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args.len() != 6 {
+        return Err("usage: arm7_reachable_probe ROM LAYOUT_JSON LAYOUT_SHA256 REQUESTS_JSON REQUESTS_SHA256 SELF_SHA256".into());
+    }
+    let executable = std::env::current_exe()?;
+    let producer = fs::read(&executable)?;
+    let parent = fs::read(&args[0])?;
+    let sidecar = fs::read(&args[1])?;
+    let requests_bytes = fs::read(&args[3])?;
+    if sha(&sidecar) != args[2] || sha(&requests_bytes) != args[4] || sha(&producer) != args[5] {
+        return Err("independent layout/request/producer hash mismatch".into());
+    }
+    let layouts: Vec<Arm7Layout> = serde_json::from_slice(&sidecar)?;
+    let requests: Vec<ProgramRequest> = serde_json::from_slice(&requests_bytes)?;
+    if layouts.is_empty() || requests.is_empty() {
+        return Err("no layouts or program requests supplied".into());
+    }
+    let mut programs = Vec::new();
+    for (index, request) in requests.iter().enumerate() {
+        if requests[..index].iter().any(|prior| prior.program == request.program) {
+            return Err("duplicate requested program".into());
+        }
+        let mut matching = layouts.iter().filter(|l| l.identity == request.program);
+        let layout = matching.next().ok_or("requested program has no pinned layout")?;
+        if matching.next().is_some() {
+            return Err("requested program has duplicate layouts".into());
+        }
+        let view = layout.checked(&parent)?;
+        let modules: Vec<_> = view.module_inputs().collect();
+        let mut observations = Vec::new();
+        for selection in &request.selections {
+            let module = modules
+                .iter()
+                .find(|m| *m.identity().region() == selection.region)
+                .ok_or("selected region has no checked module")?;
+            observations.push(observe(
+                module,
+                Selection { span: selection.extent.clone(), mode: selection.mode },
+                &modules,
+            )?);
+        }
+        let mut roots = Vec::new();
+        for root in &request.roots {
+            roots.push(RootRequest {
+                observation: observations
+                    .get(root.selection)
+                    .ok_or("root selection index is absent")?,
+                address: root.address,
+                assumption: &root.assumption,
+            });
+        }
+        let graph = connect(&observations, &roots)?;
+        let mut witnesses = Vec::new();
+        for root in graph.roots() {
+            let mut sites = Vec::new();
+            for frontier in root.frontiers() {
+                sites.push(json!({"reason":frontier.reason(),"transfers":frontier.witness()?}));
+            }
+            witnesses.push(sites);
+        }
+        programs.push(json!({"identity":view.identity(),"graph":graph,"witnesses":witnesses}));
+    }
+    if sha(&fs::read(&args[0])?) != sha(&parent)
+        || sha(&fs::read(&args[1])?) != args[2]
+        || sha(&fs::read(&args[3])?) != args[4]
+        || sha(&fs::read(&executable)?) != args[5]
+    {
+        return Err("input or producer changed during candidate graph construction".into());
+    }
+    serde_json::to_writer_pretty(
+        io::stdout().lock(),
+        &json!({
+            "schema_version":1,"status":"bounded_arm7_candidate_graphs_verified",
+            "parent_rom_sha256":sha(&parent),"layout_sidecar_sha256":args[2],
+            "request_sidecar_sha256":args[4],"producer_sha256":args[5],"inputs_unchanged":true,
+            "programs":programs,"source_bytes":0,"arm7_binary_baseline_complete":false,
+            "function_extents_established":false,"executable_coverage_established":false,
+            "original_relocations_established":false
+        }),
+    )?;
+    Ok(())
+}
