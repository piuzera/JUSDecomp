index 0000000..bcb8e3b
--- /dev/null
+++ b/lib/tests/arm7_reachable.rs
@@ -0,0 +1,286 @@
+mod common;
+use common::Fixture;
+use ds_decomp::{
+    analysis::{
+        arm7_observation::{Selection, observe},
+        arm7_reachable::{RootRequest, connect},
+    },
+    config::symbol::InstructionMode::Arm,
+};
+use serde_json::json;
+const BASE: u32 = 0x02380000;
+fn bytes(words: &[u32]) -> Vec<u8> {
+    words.iter().flat_map(|w| w.to_le_bytes()).collect()
+}
+#[test]
+fn direct_call_joins_separately_selected_checked_span() {
+    let f = Fixture::new(&bytes(&[0xeb000000, 0xe1a00000, 0xe1a01001]));
+    let view = f.parent_layout.checked(&f.parent).unwrap();
+    let modules: Vec<_> = view.module_inputs().collect();
+    let observations = [
+        observe(&modules[0], Selection { span: BASE..BASE + 4, mode: Arm }, &modules).unwrap(),
+        observe(&modules[0], Selection { span: BASE + 8..BASE + 12, mode: Arm }, &modules).unwrap(),
+    ];
+    let graph = connect(
+        &observations,
+        &[RootRequest {
+            observation: &observations[0],
+            address: BASE,
+            assumption: "invented fixture root",
+        }],
+    )
+    .unwrap();
+    let report = serde_json::to_value(graph).unwrap();
+    assert_eq!(report["nodes"].as_array().map(Vec::len), Some(2));
+    assert_eq!(report["edges"].as_array().map(Vec::len), Some(3));
+    assert_eq!(report["edges"][0]["resolution"], json!({"kind":"selected","node":1}));
+    assert_eq!(report["edges"][0]["original"]["target"]["boundary"], "outside_selection");
+    assert_eq!(report["roots"][0]["visited_nodes"], json!([0, 1]));
+}
+
+use ds_decomp::{
+    analysis::arm7_observation::SpanObservation, config::symbol::InstructionMode::Thumb,
+};
+fn error(observations: &[SpanObservation<'_>], roots: &[RootRequest<'_, '_>]) -> String {
+    format!("{:?}", connect(observations, roots).unwrap_err())
+}
+fn root<'a, 'm: 'a>(observation: &'a SpanObservation<'m>, address: u32) -> RootRequest<'a, 'm> {
+    RootRequest { observation, address, assumption: "invented root assumption" }
+}
