@@ -0,0 +1,420 @@
+//! Candidate paths through explicitly selected checked ARM7 interpretations.
+//!
+//! Roots and symbolic guards are assumptions, not execution evidence. No function,
+//! executable coverage, original relocation, or source credit is established.
+use super::arm7_observation::{
+    InstructionObservation, Mapping, ObservationBoundary, SpanObservation, Target,
+    TransferObservation,
+};
+use crate::{
+    config::symbol::InstructionMode,
+    rom::{
+        arm7::{Cpu, InstructionSet, Processor, ProgramIdentity},
+        arm7_modules::Arm7ModuleIdentity,
+    },
+};
+use serde::Serialize;
+use std::{error::Error, fmt, ops::Range};
+
+#[derive(Debug, Clone, Copy)]
+pub struct RootRequest<'o, 'm: 'o> {
+    pub observation: &'o SpanObservation<'m>,
+    pub address: u32,
+    pub assumption: &'o str,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum FrontierReason {
+    OutsideSelection,
+    InstructionInterior,
+    ModeConflict,
+    Bss,
+    Unmapped,
+    Indirect,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum ConnectError {
+    EmptyObservations,
+    EmptyRoots,
+    ForeignProgram,
+    WrongTargetPolicy,
+    DuplicateOrOverlappingSameModeSelection,
+    ForeignRoot,
+    RootNotInstructionStart,
+    EmptyRootAssumption,
+    DuplicateRoot,
+    InconsistentMappedIdentity,
+    CapacityOverflow,
+}
+impl fmt::Display for ConnectError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "ARM7 candidate graph: {self:?}")
+    }
+}
+impl Error for ConnectError {}
+
+/// Immutable owner borrowing checked observations; reports cannot construct one.
+///
+/// ```compile_fail
+/// use ds_decomp::analysis::arm7_reachable::CandidateGraph;
+/// let _: CandidateGraph<'_, '_> = serde_json::from_str("{}").unwrap();
+/// ```
+#[derive(Debug, Serialize)]
+pub struct CandidateGraph<'o, 'm: 'o> {
+    scope: &'static str,
+    program: &'o ProgramIdentity,
+    observations: &'o [SpanObservation<'m>],
+    nodes: Vec<Node<'o>>,
+    edges: Vec<Edge<'o>>,
+    roots: Vec<Traversal<'o, 'm>>,
+}
+#[derive(Debug, Serialize)]
+struct Node<'a> {
+    identity: &'a Arm7ModuleIdentity<'a>,
+    mode: InstructionMode,
+    instruction: &'a InstructionObservation,
+    mode_conflict: bool,
+    #[serde(skip)]
+    outgoing: Range<usize>,
+}
+#[derive(Debug, Serialize)]
+struct Edge<'a> {
+    source_node: usize,
+    source_condition: Option<&'a str>,
+    original: &'a TransferObservation<'a>,
+    resolution: Resolution,
+}
+#[derive(Debug, Serialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+enum Resolution {
+    Selected { node: usize },
+    Frontier { reason: FrontierReason },
+}
+#[derive(Debug, Serialize)]
+struct Traversal<'o, 'm: 'o> {
+    #[serde(skip)]
+    request: RootRequest<'o, 'm>,
+    identity: &'o Arm7ModuleIdentity<'o>,
+    mode: InstructionMode,
+    address: u32,
+    assumption: &'o str,
+    visited_nodes: Vec<usize>,
+    edge_examinations: usize,
+    predecessors: Vec<Visit>,
+    frontiers: Vec<FrontierSite>,
+}
+#[derive(Debug, Clone, Copy, Serialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+enum Visit {
+    Unvisited,
+    Root,
+    ViaEdge { edge: usize },
+}
+#[derive(Debug, Serialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+enum FrontierSite {
+    Root { reason: FrontierReason },
+    Edge { edge: usize },
+}
+
+fn reserved<T>(capacity: usize) -> Result<Vec<T>, ConnectError> {
+    let mut items = Vec::new();
+    items.try_reserve_exact(capacity).map_err(|_| ConnectError::CapacityOverflow)?;
+    Ok(items)
+}
+fn mode_index(mode: InstructionMode) -> usize {
+    match mode {
+        InstructionMode::Arm => 0,
+        InstructionMode::Thumb => 1,
+    }
+}
+fn containing(nodes: &[Node<'_>], index: &[usize], address: u32) -> Option<usize> {
+    let position = index.partition_point(|&id| nodes[id].instruction.address() <= address);
+    let id = *index.get(position.checked_sub(1)?)?;
+    let instruction = nodes[id].instruction;
+    (address - instruction.address() < u32::from(instruction.byte_len())).then_some(id)
+}
+fn resolve(
+    nodes: &[Node<'_>],
+    indexes: &[Vec<usize>; 2],
+    target: &Target<'_>,
+) -> Result<Resolution, ConnectError> {
+    let frontier = |reason| Ok(Resolution::Frontier { reason });
+    let Target::Address { address, mode, mapping, boundary } = target else {
+        return frontier(FrontierReason::Indirect);
+    };
+    let mapped = match mapping {
+        Mapping::Initialized(identity) => identity,
+        Mapping::Bss(_) => return frontier(FrontierReason::Bss),
+        Mapping::UnresolvedBytes => return frontier(FrontierReason::Unmapped),
+    };
+    if *boundary == ObservationBoundary::InstructionInterior {
+        return frontier(FrontierReason::InstructionInterior);
+    }
+    let same = containing(nodes, &indexes[mode_index(*mode)], *address);
+    let other = containing(nodes, &indexes[1 - mode_index(*mode)], *address);
+    if let Some(id) = same {
+        let node = &nodes[id];
+        if node.identity != *mapped {
+            return Err(ConnectError::InconsistentMappedIdentity);
+        }
+        if node.instruction.address() != *address {
+            return frontier(FrontierReason::InstructionInterior);
+        }
+        if node.mode_conflict {
+            return frontier(FrontierReason::ModeConflict);
+        }
+        Ok(Resolution::Selected { node: id })
+    } else if other.is_some() {
+        frontier(FrontierReason::ModeConflict)
+    } else {
+        frontier(FrontierReason::OutsideSelection)
+    }
+}
+
+/// Connect supplied interpretations atomically, without decoding or discovering bytes.
+///
+/// Each root visits at most N supplied instructions and examines at most E original
+/// transfers. Sorted instruction intervals bound joining by O(E log N). Retained
+/// storage is O(N + E + R*N); witnesses are materialized only when requested.
+/// Opposite-mode byte overlap quarantines every intersecting whole instruction.
+pub fn connect<'o, 'm: 'o>(
+    observations: &'o [SpanObservation<'m>],
+    roots: &[RootRequest<'o, 'm>],
+) -> Result<CandidateGraph<'o, 'm>, ConnectError> {
+    let first = observations.first().ok_or(ConnectError::EmptyObservations)?;
+    if roots.is_empty() {
+        return Err(ConnectError::EmptyRoots);
+    }
+    let mut n = 0usize;
+    let mut e = 0usize;
+    for observation in observations {
+        if observation.identity().program() != first.identity().program()
+            || observation.identity().cpu() != first.identity().cpu()
+        {
+            return Err(ConnectError::ForeignProgram);
+        }
+        let target = observation.target();
+        if target.cpu != Cpu::Arm7
+            || target.isa != InstructionSet::ArmV4T
+            || target.processor != Processor::Arm7Tdmi
+        {
+            return Err(ConnectError::WrongTargetPolicy);
+        }
+        n = n
+            .checked_add(observation.instructions().len())
+            .ok_or(ConnectError::CapacityOverflow)?;
+        e = e.checked_add(observation.transfers().len()).ok_or(ConnectError::CapacityOverflow)?;
+    }
+    n.checked_mul(roots.len()).ok_or(ConnectError::CapacityOverflow)?;
+    e.checked_add(1).ok_or(ConnectError::CapacityOverflow)?;
+    let mut nodes = reserved(n)?;
+    let mut edges = reserved(e)?;
+    let mut indexes: [Vec<usize>; 2] = [reserved(n)?, reserved(n)?];
+    for observation in observations {
+        let mut transfers = observation.transfers().iter().peekable();
+        for instruction in observation.instructions() {
+            let source_node = nodes.len();
+            let start = edges.len();
+            while transfers.peek().is_some_and(|t| t.source() == instruction.address()) {
+                edges.push(Edge {
+                    source_node,
+                    source_condition: instruction.condition(),
+                    original: transfers.next().unwrap(),
+                    resolution: Resolution::Frontier { reason: FrontierReason::OutsideSelection },
+                });
+            }
+            indexes[mode_index(observation.selection().mode)].push(source_node);
+            nodes.push(Node {
+                identity: observation.identity(),
+                mode: observation.selection().mode,
+                instruction,
+                mode_conflict: false,
+                outgoing: start..edges.len(),
+            });
+        }
+    }
+    for index in &mut indexes {
+        index.sort_unstable_by_key(|&id| nodes[id].instruction.address());
+        for pair in index.windows(2) {
+            let a = nodes[pair[0]].instruction;
+            let b = nodes[pair[1]].instruction;
+            let end = a
+                .address()
+                .checked_add(u32::from(a.byte_len()))
+                .ok_or(ConnectError::CapacityOverflow)?;
+            if b.address() < end {
+                return Err(ConnectError::DuplicateOrOverlappingSameModeSelection);
+            }
+        }
+    }
+    let (mut a, mut b) = (0, 0);
+    while a < indexes[0].len() && b < indexes[1].len() {
+        let (left, right) = (indexes[0][a], indexes[1][b]);
+        let l = nodes[left].instruction;
+        let r = nodes[right].instruction;
+        let le = l
+            .address()
+            .checked_add(u32::from(l.byte_len()))
+            .ok_or(ConnectError::CapacityOverflow)?;
+        let re = r
+            .address()
+            .checked_add(u32::from(r.byte_len()))
+            .ok_or(ConnectError::CapacityOverflow)?;
+        if l.address() < re && r.address() < le {
+            nodes[left].mode_conflict = true;
+            nodes[right].mode_conflict = true;
+        }
+        if le <= re {
+            a += 1;
+        }
+        if re <= le {
+            b += 1;
+        }
+    }
+    for edge in &mut edges {
+        edge.resolution = resolve(&nodes, &indexes, edge.original.target())?;
+    }
+    let mut traversals = reserved(roots.len())?;
+    for (root_index, request) in roots.iter().enumerate() {
+        if !observations.iter().any(|o| std::ptr::eq(o, request.observation)) {
+            return Err(ConnectError::ForeignRoot);
+        }
+        if request.assumption.trim().is_empty() {
+            return Err(ConnectError::EmptyRootAssumption);
+        }
+        if request
+            .observation
+            .instructions()
+            .binary_search_by_key(&request.address, |i| i.address())
+            .is_err()
+        {
+            return Err(ConnectError::RootNotInstructionStart);
+        }
+        if roots[..root_index].iter().any(|prior| {
+            std::ptr::eq(prior.observation, request.observation) && prior.address == request.address
+        }) {
+            return Err(ConnectError::DuplicateRoot);
+        }
+        let mode = request.observation.selection().mode;
+        let root_node = containing(&nodes, &indexes[mode_index(mode)], request.address).unwrap();
+        let mut traversal = Traversal {
+            request: *request,
+            identity: request.observation.identity(),
+            mode,
+            address: request.address,
+            assumption: request.assumption,
+            visited_nodes: reserved(n)?,
+            edge_examinations: 0,
+            predecessors: reserved(n)?,
+            frontiers: reserved(e.checked_add(1).ok_or(ConnectError::CapacityOverflow)?)?,
+        };
+        traversal.predecessors.resize(n, Visit::Unvisited);
+        if nodes[root_node].mode_conflict {
+            traversal.frontiers.push(FrontierSite::Root { reason: FrontierReason::ModeConflict });
+        } else {
+            traversal.predecessors[root_node] = Visit::Root;
+            traversal.visited_nodes.push(root_node);
+            let mut position = 0;
+            while position < traversal.visited_nodes.len() {
+                let source = traversal.visited_nodes[position];
+                for edge_id in nodes[source].outgoing.clone() {
+                    traversal.edge_examinations += 1;
+                    match edges[edge_id].resolution {
+                        Resolution::Selected { node } => {
+                            if matches!(traversal.predecessors[node], Visit::Unvisited) {
+                                traversal.predecessors[node] = Visit::ViaEdge { edge: edge_id };
+                                traversal.visited_nodes.push(node);
+                            }
+                        }
+                        Resolution::Frontier { .. } => {
+                            traversal.frontiers.push(FrontierSite::Edge { edge: edge_id })
+                        }
+                    }
+                }
+                position += 1;
+            }
+        }
+        traversals.push(traversal);
+    }
+    Ok(CandidateGraph {
+        scope: "root_assumed_selected_interpretations",
+        program: first.identity().program(),
+        observations,
+        nodes,
+        edges,
+        roots: traversals,
+    })
+}
+
+impl<'o, 'm: 'o> CandidateGraph<'o, 'm> {
+    pub fn program(&self) -> &ProgramIdentity {
+        self.program
+    }
+    pub fn node_count(&self) -> usize {
+        self.nodes.len()
+    }
+    pub fn edge_count(&self) -> usize {
+        self.edges.len()
+    }
+    pub fn roots(&self) -> impl Iterator<Item = RootView<'_, 'o, 'm>> {
+        (0..self.roots.len()).map(|root_index| RootView { graph: self, root_index })
+    }
+}
+pub struct RootView<'g, 'o, 'm: 'o> {
+    graph: &'g CandidateGraph<'o, 'm>,
+    root_index: usize,
+}
+impl<'g, 'o, 'm: 'o> RootView<'g, 'o, 'm> {
+    pub fn request(&self) -> &RootRequest<'o, 'm> {
+        &self.graph.roots[self.root_index].request
+    }
+    pub fn visit_count(&self) -> usize {
+        self.graph.roots[self.root_index].visited_nodes.len()
+    }
+    pub fn edge_examinations(&self) -> usize {
+        self.graph.roots[self.root_index].edge_examinations
+    }
+    pub fn frontiers(&self) -> impl Iterator<Item = FrontierView<'g, 'o, 'm>> {
+        (0..self.graph.roots[self.root_index].frontiers.len()).map(|frontier_index| FrontierView {
+            graph: self.graph,
+            root_index: self.root_index,
+            frontier_index,
+        })
+    }
+}
+pub struct FrontierView<'g, 'o, 'm: 'o> {
+    graph: &'g CandidateGraph<'o, 'm>,
+    root_index: usize,
+    frontier_index: usize,
+}
+impl<'o, 'm: 'o> FrontierView<'_, 'o, 'm> {
+    pub fn reason(&self) -> FrontierReason {
+        match self.graph.roots[self.root_index].frontiers[self.frontier_index] {
+            FrontierSite::Root { reason } => reason,
+            FrontierSite::Edge { edge } => match self.graph.edges[edge].resolution {
+                Resolution::Frontier { reason } => reason,
+                Resolution::Selected { .. } => {
+                    unreachable!("frontier sites only reference frontier edges")
+                }
+            },
+        }
+    }
+    /// One shortest candidate witness, including the terminal frontier transfer.
+    /// Root conflicts have an empty witness. Guards are not solved for feasibility.
+    pub fn witness(&self) -> Result<Vec<&'o TransferObservation<'o>>, ConnectError> {
+        let traversal = &self.graph.roots[self.root_index];
+        let FrontierSite::Edge { edge } = traversal.frontiers[self.frontier_index] else {
+            return Ok(Vec::new());
+        };
+        let mut result = reserved(self.graph.nodes.len())?;
+        result.push(self.graph.edges[edge].original);
+        let mut node = self.graph.edges[edge].source_node;
+        while let Visit::ViaEdge { edge } = traversal.predecessors[node] {
+            result.push(self.graph.edges[edge].original);
+            node = self.graph.edges[edge].source_node;
+        }
+        result.reverse();
+        Ok(result)
+    }
+}
