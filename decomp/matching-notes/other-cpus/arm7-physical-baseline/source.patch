+        fs::write(&mutator,format!("import pathlib,time,sys\np=pathlib.Path(sys.argv[1])\nfor _ in range(10000):\n if (p/'arm7.bin').exists():\n  f=p/'{target}';b=bytearray(f.read_bytes())\n  if '{target}'=='linked.elf': b[18:20]=b'\\x00\\x00'\n  else: b[0]^=1\n  f.write_bytes(b);(p/'mutation-ran').write_text('{target}');break\n time.sleep(.001)\n")).unwrap();
+        fs::set_permissions(&wrapper, fs::Permissions::from_mode(0o755)).unwrap();
