+    assert_eq!(
+        report["selected_inputs"].as_array().expect("actual linked input snapshot").len(),
+        5
+    );
+    for artifact in report["artifacts"].as_array().unwrap() {
+        let bytes = fs::read(out.join(artifact["name"].as_str().unwrap())).unwrap();
+        assert_eq!(artifact["sha256"], format!("{:x}", Sha256::digest(bytes)));
