+fn section(elf: &[u8], wanted: &str) -> u32 {
+    let sh = word(elf, 32).unwrap();
+    let strings = sh + half(elf, 50).unwrap() as u32 * 40;
+    let names =
+        bytes(elf, word(elf, strings + 16).unwrap(), word(elf, strings + 20).unwrap()).unwrap();
+    (0..half(elf, 48).unwrap() as u32)
+        .map(|i| sh + i * 40)
+        .find(|h| name(names, word(elf, *h).unwrap()).unwrap() == wanted)
+        .unwrap()
+}
