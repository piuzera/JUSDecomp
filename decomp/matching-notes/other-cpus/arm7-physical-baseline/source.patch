diff --git a/lib/src/rom/arm7_physical_baseline.rs b/lib/src/rom/arm7_physical_baseline.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5e14db0ed551c3ded836af7222f617459ad120ae
--- /dev/null
+++ b/lib/src/rom/arm7_physical_baseline.rs
@@ -0,0 +1,725 @@
+//! Native opaque physical ARM7 payload/layout preservation. No source or code classification.
+use super::arm7::{Arm7Region, Arm7View, ProgramIdentity};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::{
+    fmt, fs, io,
+    ops::Range,
+    path::{Path, PathBuf},
+    process::Command,
+};
+
+#[derive(Debug)]
+pub enum PhysicalBaselineError {
+    Io(io::Error),
+    Rejected(&'static str),
+    ToolFailed,
+}
+impl fmt::Display for PhysicalBaselineError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "ARM7 physical baseline: {self:?}")
+    }
+}
+impl std::error::Error for PhysicalBaselineError {}
+impl From<io::Error> for PhysicalBaselineError {
+    fn from(e: io::Error) -> Self {
+        Self::Io(e)
+    }
+}
+type Result<T> = std::result::Result<T, PhysicalBaselineError>;
+fn require(ok: bool, reason: &'static str) -> Result<()> {
+    if ok { Ok(()) } else { Err(PhysicalBaselineError::Rejected(reason)) }
+}
+fn sha(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeToolPin {
+    pub executable: PathBuf,
+    pub sha256: String,
+    pub version: String,
+}
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativePins {
+    pub clang: NativeToolPin,
+    pub lld: NativeToolPin,
+}
+#[derive(Debug, Clone, Serialize)]
+struct Artifact {
+    name: String,
+    bytes: usize,
+    sha256: String,
+}
+#[derive(Debug, Serialize)]
+struct Segment {
+    section: String,
+    vma: u32,
+    lma: u32,
+    file_bytes: u32,
+    memory_bytes: u32,
+    file_offset: u32,
+    alignment: u32,
+    flags: u32,
+}
+#[derive(Debug, Serialize)]
+struct Invocation {
+    tool_sha256: String,
+    arguments: Vec<String>,
+    return_code: i32,
+}
+#[derive(Debug, Serialize)]
+pub struct VerifiedOpaqueBaseline {
+    identity: ProgramIdentity,
+    status: &'static str,
+    source_bytes: u64,
+    functions: &'static str,
+    executability: &'static str,
+    original_relocations: &'static str,
+    arm7_source_complete: bool,
+    t10_complete: bool,
+    bootable_elf: bool,
+    entry: u32,
+    image_offset: u32,
+    image_bytes: u32,
+    image_sha256: String,
+    header_sha256: String,
+    params_offset: u32,
+    params_sha256: String,
+    table_extent: Range<u32>,
+    table_sha256: String,
+    regions: Vec<Arm7Region>,
+    generated_cpu_arch: &'static str,
+    generated_elf_abi_flags: u32,
+    commands: Vec<Invocation>,
+    selected_inputs: Vec<Artifact>,
+    segments: Vec<Segment>,
+    artifacts: Vec<Artifact>,
+    clang_sha256: String,
+    lld_sha256: String,
+}
+impl VerifiedOpaqueBaseline {
+    pub fn identity(&self) -> &ProgramIdentity {
+        &self.identity
+    }
+    pub fn source_bytes(&self) -> u64 {
+        self.source_bytes
+    }
+}
+// Borrow checked descriptions; this private representation describes native sections only.
+struct Part<'a> {
+    name: String,
+    vma: u32,
+    lma: u32,
+    stored: Range<u32>,
+    bytes: &'a [u8],
+    bss: u32,
+}
+fn parts<'a>(view: &'a Arm7View<'_>) -> Result<Vec<Part<'a>>> {
+    let mut parts = Vec::new();
+    for (i, region) in std::iter::once(view.startup()).chain(view.autoloads()).enumerate() {
+        let d = region.description();
+        let name = if i == 0 { "startup".into() } else { format!("autoload{}", i - 1) };
+        parts.push(Part {
+            name,
+            vma: d.runtime_base,
+            lma: view
+                .checked_envelope()
+                .base
+                .checked_add(d.stored_extent.start)
+                .ok_or(PhysicalBaselineError::Rejected("LMA overflow"))?,
+            stored: d.stored_extent.clone(),
+            bytes: region.bytes(),
+            bss: d.bss_bytes,
+        });
+    }
+    parts.push(Part {
+        name: "table".into(),
+        vma: view
+            .checked_envelope()
+            .base
+            .checked_add(view.checked_envelope().table_extent.start)
+            .ok_or(PhysicalBaselineError::Rejected("table overflow"))?,
+        lma: view
+            .checked_envelope()
+            .base
+            .checked_add(view.checked_envelope().table_extent.start)
+            .ok_or(PhysicalBaselineError::Rejected("table overflow"))?,
+        stored: view.checked_envelope().table_extent.clone(),
+        bytes: view.table(),
+        bss: 0,
+    });
+    Ok(parts)
+}
+fn verify_tool(pin: &NativeToolPin) -> Result<()> {
+    require(sha(&fs::read(&pin.executable)?) == pin.sha256, "native tool hash")?;
+    let result = Command::new(&pin.executable).arg("--version").output()?;
+    require(
+        result.status.success()
+            && !pin.version.is_empty()
+            && String::from_utf8_lossy(&result.stdout).lines().next() == Some(&pin.version),
+        "native tool version",
+    )
+}
+fn run(tool: &Path, args: &[&str], out: &Path) -> Result<()> {
+    let result = Command::new(tool).args(args).current_dir(out).output()?;
+    if result.status.success() {
+        Ok(())
+    } else {
+        Err(PhysicalBaselineError::ToolFailed)
+    }
+}
+
+/// One operation on immutable checked ownership. All binary artifacts remain private.
+pub fn build(
+    view: &Arm7View<'_>,
+    tools: &NativePins,
+    out: &Path,
+) -> Result<VerifiedOpaqueBaseline> {
+    verify_tool(&tools.clang)?;
+    verify_tool(&tools.lld)?;
+    let meta = fs::symlink_metadata(out)?;
+    require(
+        meta.is_dir() && !meta.file_type().is_symlink() && fs::read_dir(out)?.next().is_none(),
+        "output must be empty directory",
+    )?;
+    let parts = parts(view)?;
+    let mut commands = Vec::new();
+    let mut selected_snapshot = Vec::new();
+    let mut layout = Vec::new();
+    for part in &parts {
+        let data_name = format!("{}.bin", part.name);
+        fs::write(out.join(&data_name), part.bytes)?;
+        selected_snapshot.push(Artifact {
+            name: data_name.clone(),
+            bytes: part.bytes.len(),
+            sha256: sha(part.bytes),
+        });
+        let source_name = format!("{}.s", part.name);
+        let mut source = format!(
+            ".cpu arm7tdmi\n.section .arm7.{},\"a\",%progbits\n.balign 4\n.incbin \"{}.bin\"\n",
+            part.name, part.name
+        );
+        if part.bss != 0 {
+            source.push_str(&format!(
+                ".section .arm7.bss.{},\"aw\",%nobits\n.balign 4\n.space {}\n",
+                part.name, part.bss
+            ));
+        }
+        fs::write(out.join(&source_name), &source)?;
+        selected_snapshot.push(Artifact {
+            name: source_name.clone(),
+            bytes: source.len(),
+            sha256: sha(source.as_bytes()),
+        });
+        let object_name = format!("{}.o", part.name);
+        let args =
+            ["--target=arm-none-eabi", "-mcpu=arm7tdmi", "-c", &source_name, "-o", &object_name];
+        run(&tools.clang.executable, &args, out)?;
+        commands.push(Invocation {
+            tool_sha256: tools.clang.sha256.clone(),
+            arguments: args.iter().map(|a| (*a).to_owned()).collect(),
+            return_code: 0,
+        });
+        let object = fs::read(out.join(&object_name))?;
+        validate_object(part, &object)?;
+        selected_snapshot.push(Artifact {
+            name: object_name.clone(),
+            bytes: object.len(),
+            sha256: sha(&object),
+        });
+        layout.push((
+            part.vma,
+            format!(".arm7.{}", part.name),
+            part.lma,
+            part.bytes.len() as u32,
+            object_name.clone(),
+            false,
+        ));
+        if part.bss != 0 {
+            let vma = part
+                .vma
+                .checked_add(part.bytes.len() as u32)
+                .ok_or(PhysicalBaselineError::Rejected("BSS overflow"))?;
+            layout.push((
+                vma,
+                format!(".arm7.bss.{}", part.name),
+                vma,
+                part.bss,
+                object_name,
+                true,
+            ));
+        }
+    }
+    layout.sort_by_key(|p| p.0);
+    let mut script = format!(
+        "ARM7_HEADER_ENTRY = {};\nENTRY(ARM7_HEADER_ENTRY)\nPHDRS {{\n",
+        view.checked_envelope().entry
+    );
+    for (i, part) in layout.iter().enumerate() {
+        script.push_str(&format!("p{i} PT_LOAD FLAGS({});\n", if part.5 { 6 } else { 4 }));
+    }
+    script.push_str("}\nSECTIONS {\n");
+    for (i, p) in layout.iter().enumerate() {
+        script.push_str(&format!(
+            "{} {} {} : AT({}) {{ {}({}) }} :p{}\nASSERT(SIZEOF({}) == {}, \"size\")\n",
+            p.1,
+            p.0,
+            if p.5 { "(NOLOAD)" } else { "" },
+            p.2,
+            p.4,
+            p.1,
+            i,
+            p.1,
+            p.3
+        ));
+    }
+    script.push_str("}\n");
+    fs::write(out.join("physical.ld"), &script)?;
+    selected_snapshot.push(Artifact {
+        name: "physical.ld".into(),
+        bytes: script.len(),
+        sha256: sha(script.as_bytes()),
+    });
+    let mut args = vec![
+        "-m",
+        "armelf",
+        "--nmagic",
+        "-T",
+        "physical.ld",
+        "-Map",
+        "physical.map",
+        "-o",
+        "linked.elf",
+    ];
+    let objects: Vec<_> = parts.iter().map(|p| format!("{}.o", p.name)).collect();
+    args.extend(objects.iter().map(String::as_str));
+    run(&tools.lld.executable, &args, out)?;
+    commands.push(Invocation {
+        tool_sha256: tools.lld.sha256.clone(),
+        arguments: args.iter().map(|a| (*a).to_owned()).collect(),
+        return_code: 0,
+    });
+    for a in &selected_snapshot {
+        require(
+            sha(&fs::read(out.join(&a.name))?) == a.sha256,
+            "selected input changed during link",
+        )?;
+    }
+    let elf = fs::read(out.join("linked.elf"))?;
+    let linked_artifact =
+        Artifact { name: "linked.elf".into(), bytes: elf.len(), sha256: sha(&elf) };
+    let (segments, image) = validate_linked(view, &elf)?;
+    let image_artifact =
+        Artifact { name: "arm7.bin".into(), bytes: image.len(), sha256: sha(&image) };
+    fs::write(out.join("arm7.bin"), &image)?;
+    let map = fs::read(out.join("physical.map"))?;
+    let mut artifacts = selected_snapshot.clone();
+    artifacts.extend([
+        Artifact { name: "physical.map".into(), bytes: map.len(), sha256: sha(&map) },
+        linked_artifact,
+        image_artifact,
+    ]);
+    verify_tool(&tools.clang)?;
+    verify_tool(&tools.lld)?;
+    for a in &artifacts {
+        let actual = fs::read(out.join(&a.name))?;
+        require(actual.len() == a.bytes && sha(&actual) == a.sha256, "artifact changed")?;
+    }
+    let c = view.checked_envelope();
+    Ok(VerifiedOpaqueBaseline {
+        identity: view.identity().clone(),
+        status: "opaque_physical_baseline_verified",
+        source_bytes: 0,
+        functions: "unknown",
+        executability: "unknown",
+        original_relocations: "unknown",
+        arm7_source_complete: false,
+        t10_complete: false,
+        bootable_elf: false,
+        entry: c.entry,
+        image_offset: c.image_offset,
+        image_bytes: c.image_bytes,
+        image_sha256: c.image_sha256.clone(),
+        header_sha256: c.header_sha256.clone(),
+        params_offset: c.params_offset,
+        params_sha256: c.params_sha256.clone(),
+        table_extent: c.table_extent.clone(),
+        table_sha256: c.table_sha256.clone(),
+        regions: std::iter::once(view.startup())
+            .chain(view.autoloads())
+            .map(|r| r.description().clone())
+            .collect(),
+        generated_cpu_arch: "ARMv4T",
+        generated_elf_abi_flags: word(&elf, 36)?,
+        commands,
+        selected_inputs: selected_snapshot
+            .into_iter()
+            .filter(|a| a.name.ends_with(".o") || a.name == "physical.ld")
+            .collect(),
+        segments,
+        artifacts,
+        clang_sha256: tools.clang.sha256.clone(),
+        lld_sha256: tools.lld.sha256.clone(),
+    })
+}
+fn bytes(data: &[u8], offset: u32, size: u32) -> Result<&[u8]> {
+    let end =
+        offset.checked_add(size).ok_or(PhysicalBaselineError::Rejected("ELF extent overflow"))?;
+    data.get(offset as usize..end as usize).ok_or(PhysicalBaselineError::Rejected("ELF bounds"))
+}
+fn word(data: &[u8], offset: u32) -> Result<u32> {
+    Ok(u32::from_le_bytes(bytes(data, offset, 4)?.try_into().unwrap()))
+}
+fn half(data: &[u8], offset: u32) -> Result<u16> {
+    Ok(u16::from_le_bytes(bytes(data, offset, 2)?.try_into().unwrap()))
+}
+fn name(data: &[u8], offset: u32) -> Result<&str> {
+    let tail =
+        data.get(offset as usize..).ok_or(PhysicalBaselineError::Rejected("ELF name offset"))?;
+    let end = tail
+        .iter()
+        .position(|b| *b == 0)
+        .ok_or(PhysicalBaselineError::Rejected("ELF name terminator"))?;
+    std::str::from_utf8(&tail[..end])
+        .map_err(|_| PhysicalBaselineError::Rejected("ELF name encoding"))
+}
+struct Section {
+    name: String,
+    kind: u32,
+    flags: u32,
+    address: u32,
+    offset: u32,
+    size: u32,
+    link: u32,
+    align: u32,
+    entry_size: u32,
+}
+fn read_sections(elf: &[u8], expected_type: u16) -> Result<Vec<Section>> {
+    require(bytes(elf, 0, 7)? == b"\x7fELF\x01\x01\x01", "ELF32 little endian")?;
+    require(
+        half(elf, 16)? == expected_type && half(elf, 18)? == 40 && word(elf, 20)? == 1,
+        "ELF machine/type",
+    )?;
+    require(bytes(elf, 7, 9)? == [0; 9], "ELF ABI header")?;
+    require(
+        word(elf, 36)? == if expected_type == 2 { 0x05000200 } else { 0x05000000 },
+        "generated ELF ABI flags",
+    )?;
+    require(half(elf, 40)? == 52 && half(elf, 46)? == 40, "ELF table entry size")?;
+    if expected_type == 2 {
+        require(half(elf, 42)? == 32, "ELF program entry size")?;
+    } else {
+        require(
+            word(elf, 24)? == 0
+                && word(elf, 28)? == 0
+                && half(elf, 42)? == 0
+                && half(elf, 44)? == 0,
+            "object program header",
+        )?;
+    }
+    let shoff = word(elf, 32)?;
+    let shnum = half(elf, 48)? as u32;
+    let stridx = half(elf, 50)? as u32;
+    require(shnum > 0 && stridx > 0 && stridx < shnum, "ELF section count")?;
+    bytes(
+        elf,
+        shoff,
+        shnum.checked_mul(40).ok_or(PhysicalBaselineError::Rejected("ELF section overflow"))?,
+    )?;
+    require(bytes(elf, shoff, 40)? == [0; 40], "null ELF section")?;
+    let string_header = shoff + stridx * 40;
+    require(
+        word(elf, string_header + 4)? == 3 && word(elf, string_header + 8)? == 0,
+        "section names table type",
+    )?;
+    let strings = bytes(elf, word(elf, string_header + 16)?, word(elf, string_header + 20)?)?;
+    let mut sections = Vec::new();
+    for i in 0..shnum {
+        let h = shoff + i * 40;
+        let s = Section {
+            name: name(strings, word(elf, h)?)?.into(),
+            kind: word(elf, h + 4)?,
+            flags: word(elf, h + 8)?,
+            address: word(elf, h + 12)?,
+            offset: word(elf, h + 16)?,
+            size: word(elf, h + 20)?,
+            link: word(elf, h + 24)?,
+            align: word(elf, h + 32)?,
+            entry_size: word(elf, h + 36)?,
+        };
+        if s.kind != 8 {
+            bytes(elf, s.offset, s.size)?;
+        }
+        require(
+            (s.flags & 4 == 0 || (s.name == ".text" && s.size == 0 && s.kind == 1 && s.flags == 6))
+                && s.kind != 4
+                && s.kind != 9,
+            "ELF executable/relocation section",
+        )?;
+        if !s.name.is_empty() {
+            require(!sections.iter().any(|p: &Section| p.name == s.name), "ELF duplicate section")?;
+        }
+        sections.push(s);
+    }
+    for (i, s) in sections.iter().enumerate() {
+        require(
+            s.align <= 1
+                || (s.align.is_power_of_two()
+                    && s.address.is_multiple_of(s.align)
+                    && (s.kind == 8 || s.offset.is_multiple_of(s.align))),
+            "ELF section alignment",
+        )?;
+        if s.kind != 8 && s.size != 0 {
+            let end = s
+                .offset
+                .checked_add(s.size)
+                .ok_or(PhysicalBaselineError::Rejected("section overflow"))?;
+            let she = shoff + shnum * 40;
+            require(
+                s.offset >= 52 && !(s.offset < she && shoff < end),
+                "ELF section/header overlap",
+            )?;
+            for other in &sections[..i] {
+                if other.kind != 8 && other.size != 0 {
+                    require(
+                        !(s.offset < other.offset + other.size && other.offset < end),
+                        "ELF file section overlap",
+                    )?;
+                }
+            }
+        }
+    }
+    validate_metadata(elf, &sections, expected_type)?;
+    Ok(sections)
+}
+fn validate_linked(view: &Arm7View<'_>, elf: &[u8]) -> Result<(Vec<Segment>, Vec<u8>)> {
+    let sections = read_sections(elf, 2)?;
+    require(word(elf, 24)? == view.checked_envelope().entry, "ELF entry")?;
+    let parts = parts(view)?;
+    let mut expected = Vec::new();
+    for p in &parts {
+        expected.push((format!(".arm7.{}", p.name), p.vma, p.lma, p.bytes.len() as u32, false));
+        if p.bss != 0 {
+            let b = p.vma + p.bytes.len() as u32;
+            expected.push((format!(".arm7.bss.{}", p.name), b, b, p.bss, true));
+        }
+    }
+    expected.sort_by_key(|p| p.1);
+    require(
+        sections.iter().filter(|s| s.flags & 2 != 0 && s.size != 0).count() == expected.len(),
+        "ELF allocated section count",
+    )?;
+    let phoff = word(elf, 28)?;
+    let phnum = half(elf, 44)? as u32;
+    require(phnum as usize == expected.len(), "ELF segment count")?;
+    bytes(elf, phoff, phnum * 32)?;
+    require(
+        phoff == 52
+            && sections
+                .iter()
+                .all(|s| s.kind == 8 || s.size == 0 || s.offset >= phoff + phnum * 32),
+        "ELF segment/header overlap",
+    )?;
+    let mut segments = Vec::new();
+    for (i, p) in expected.iter().enumerate() {
+        let s = sections
+            .iter()
+            .find(|s| s.name == p.0)
+            .ok_or(PhysicalBaselineError::Rejected("ELF missing section"))?;
+        require(
+            s.address == p.1
+                && s.size == p.3
+                && s.kind == if p.4 { 8 } else { 1 }
+                && s.flags == if p.4 { 3 } else { 2 }
+                && s.align == 4,
+            "ELF physical section",
+        )?;
+        let h = phoff + i as u32 * 32;
+        let offset = word(elf, h + 4)?;
+        let vma = word(elf, h + 8)?;
+        let lma = word(elf, h + 12)?;
+        let file = word(elf, h + 16)?;
+        let memory = word(elf, h + 20)?;
+        let flags = word(elf, h + 24)?;
+        let align = word(elf, h + 28)?;
+        require(
+            word(elf, h)? == 1
+                && vma == p.1
+                && lma == p.2
+                && file == if p.4 { 0 } else { p.3 }
+                && memory == p.3
+                && flags == if p.4 { 6 } else { 4 },
+            "ELF physical segment",
+        )?;
+        require(
+            align <= 1 || (align.is_power_of_two() && vma % align == offset % align),
+            "ELF segment alignment",
+        )?;
+        if !p.4 {
+            require(
+                offset == s.offset && bytes(elf, offset, file)? == bytes(elf, s.offset, s.size)?,
+                "ELF segment bytes",
+            )?;
+        }
+        segments.push(Segment {
+            section: p.0.clone(),
+            vma,
+            lma,
+            file_bytes: file,
+            memory_bytes: memory,
+            file_offset: offset,
+            alignment: align,
+            flags,
+        });
+    }
+    let mut image = Vec::new();
+    for p in &parts {
+        require(image.len() as u32 == p.stored.start, "stored ordering")?;
+        let s = sections.iter().find(|s| s.name == format!(".arm7.{}", p.name)).unwrap();
+        let content = bytes(elf, s.offset, s.size)?;
+        require(content == p.bytes, "ELF original bytes")?;
+        image.extend_from_slice(content);
+        require(image.len() as u32 == p.stored.end, "stored extent")?;
+    }
+    require(
+        image.len() as u32 == view.checked_envelope().image_bytes
+            && sha(&image) == view.checked_envelope().image_sha256,
+        "stored image hash",
+    )?;
+    require(
+        sha(bytes(&image, view.checked_envelope().params_offset, 20)?)
+            == view.checked_envelope().params_sha256,
+        "stored parameter hash",
+    )?;
+    Ok((segments, image))
+}
+
+fn uleb(data: &[u8], cursor: &mut usize) -> Result<u32> {
+    let mut value = 0u32;
+    for shift in (0..35).step_by(7) {
+        let b =
+            *data.get(*cursor).ok_or(PhysicalBaselineError::Rejected("ELF attribute bounds"))?;
+        *cursor += 1;
+        require(shift != 28 || b & 0xf0 == 0, "ELF attribute overflow")?;
+        value |= (b as u32 & 127) << shift;
+        if b & 128 == 0 {
+            return Ok(value);
+        }
+    }
+    Err(PhysicalBaselineError::Rejected("ELF attribute encoding"))
+}
+fn validate_metadata(elf: &[u8], sections: &[Section], kind: u16) -> Result<()> {
+    let attr = sections
+        .iter()
+        .find(|s| s.name == ".ARM.attributes")
+        .ok_or(PhysicalBaselineError::Rejected("missing ARM attributes"))?;
+    require(attr.kind == 0x70000003 && attr.flags == 0, "ARM attributes section")?;
+    let data = bytes(elf, attr.offset, attr.size)?;
+    require(
+        data.first() == Some(&b'A')
+            && word(data, 1)?.checked_add(1) == Some(data.len() as u32)
+            && bytes(data, 5, 6)? == b"aeabi\0"
+            && bytes(data, 11, 1)? == [1]
+            && word(data, 12)?.checked_add(11) == Some(data.len() as u32),
+        "ARM attributes structure",
+    )?;
+    let mut cursor = 16;
+    let mut tags = Vec::new();
+    while cursor < data.len() {
+        let tag = uleb(data, &mut cursor)?;
+        require(!tags.contains(&tag), "duplicate ARM attribute")?;
+        tags.push(tag);
+        if tag == 5 {
+            let cpu = name(data, cursor as u32)?;
+            require(cpu == "arm7tdmi", "ARM CPU attribute")?;
+            cursor += cpu.len() + 1;
+        } else {
+            let value = uleb(data, &mut cursor)?;
+            require(
+                matches!((tag, value), (6, 2) | (8, 1) | (9, 1) | (34, 0)),
+                "ARMv4T attributes",
+            )?;
+        }
+    }
+    tags.sort();
+    require(tags == [5, 6, 8, 9, 34], "missing ARMv4T attribute")?;
+    let symbols = sections
+        .iter()
+        .find(|s| s.name == ".symtab")
+        .ok_or(PhysicalBaselineError::Rejected("missing symbol table"))?;
+    require(
+        symbols.kind == 2 && symbols.entry_size == 16 && symbols.size.is_multiple_of(16),
+        "symbol table shape",
+    )?;
+    let strings = sections
+        .get(symbols.link as usize)
+        .ok_or(PhysicalBaselineError::Rejected("symbol strings index"))?;
+    require(strings.kind == 3, "symbol strings type")?;
+    let names = bytes(elf, strings.offset, strings.size)?;
+    let data = bytes(elf, symbols.offset, symbols.size)?;
+    require(data.len() >= 16 && data[..16] == [0; 16], "null ELF symbol")?;
+    let mut entry_anchors = 0;
+    for offset in (16..data.len()).step_by(16) {
+        let off = offset as u32;
+        let name = name(names, word(data, off)?)?;
+        let info = data[offset + 12];
+        let index = half(data, off + 14)?;
+        require(info & 15 != 2 && (index != 0 || name.is_empty()), "function/undefined symbol")?;
+        if name == "ARM7_HEADER_ENTRY" {
+            entry_anchors += 1;
+        }
+        require(
+            (kind == 2
+                && name == "ARM7_HEADER_ENTRY"
+                && info == 0x10
+                && index == 0xfff1
+                && word(data, off + 4)? == word(elf, 24)?
+                && word(data, off + 8)? == 0)
+                || (name.is_empty() && info == 3 && (index as usize) < sections.len()),
+            "unexpected generated symbol",
+        )?;
+    }
+    require(entry_anchors == usize::from(kind == 2), "generated entry anchor count")?;
+    Ok(())
+}
+fn validate_object(part: &Part<'_>, elf: &[u8]) -> Result<()> {
+    let sections = read_sections(elf, 1)?;
+    let expected = 1 + usize::from(part.bss != 0);
+    require(
+        sections.iter().filter(|s| s.flags & 2 != 0 && s.size != 0).count() == expected,
+        "object allocated sections",
+    )?;
+    let section = sections
+        .iter()
+        .find(|s| s.name == format!(".arm7.{}", part.name))
+        .ok_or(PhysicalBaselineError::Rejected("object missing initialized section"))?;
+    require(
+        section.kind == 1
+            && section.flags == 2
+            && section.address == 0
+            && section.align == 4
+            && bytes(elf, section.offset, section.size)? == part.bytes,
+        "object initialized payload",
+    )?;
+    if part.bss != 0 {
+        let section = sections
+            .iter()
+            .find(|s| s.name == format!(".arm7.bss.{}", part.name))
+            .ok_or(PhysicalBaselineError::Rejected("object missing BSS"))?;
+        require(
+            section.kind == 8
+                && section.flags == 3
+                && section.address == 0
+                && section.align == 4
+                && section.size == part.bss,
+            "object BSS",
+        )?;
+    }
+    Ok(())
+}
