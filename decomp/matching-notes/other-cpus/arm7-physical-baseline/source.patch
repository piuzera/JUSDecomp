+        clang: NativeToolPin {
+            executable: PathBuf::from("/opt/homebrew/opt/llvm/bin/clang"),
+            sha256: "d64d1ee59d8aff01397eb88adea263e490ac65766faefc8b5323b4a06d0438e5".into(),
+            version: "Homebrew clang version 23.1.2".into(),
+        },
