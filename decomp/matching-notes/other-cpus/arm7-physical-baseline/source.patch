+    let regions = report["regions"].as_array().expect("original checked region metadata");
+    assert_eq!(regions.len(), 3);
+    assert_eq!(regions[1]["stored_extent"]["start"], 64);
+    assert_eq!(regions[1]["runtime_base"], 0x037f8000u32);
+    assert_eq!(regions[1]["sha256"], f.parent_layout.regions[1].sha256);
