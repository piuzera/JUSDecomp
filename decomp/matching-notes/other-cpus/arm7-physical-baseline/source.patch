+static NEXT: AtomicUsize = AtomicUsize::new(0);
+fn output() -> PathBuf {
+    let root = PathBuf::from(std::env::var_os("CARGO_TARGET_DIR").unwrap());
+    let path = root.join(format!(
+        "physical-test-{}-{}",
+        std::process::id(),
+        NEXT.fetch_add(1, Ordering::Relaxed)
+    ));
