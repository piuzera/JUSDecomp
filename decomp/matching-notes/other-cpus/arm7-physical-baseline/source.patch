+#[test]
+fn native_fixture_preserves_loader_order_with_distinct_vmas_lmas_and_bss() {
+    let f = Fixture::new(&[1, 2, 3, 4]);
+    let original = f.parent.clone();
+    let view = f.parent_layout.checked(&f.parent).unwrap();
+    let out = output();
+    let result = build(&view, &pins(), &out).unwrap();
+    assert_eq!(result.identity(), view.identity());
+    assert_eq!(result.source_bytes(), 0);
+    let rebuilt = fs::read(out.join("arm7.bin")).unwrap();
+    assert_eq!(rebuilt, f.parent[0x4000..0x4078]);
+    let report = serde_json::to_value(&result).unwrap();
+    assert_eq!(report["image_sha256"], format!("{:x}", Sha256::digest(&rebuilt)));
+    let segments = report["segments"].as_array().unwrap();
+    assert_eq!(segments.len(), 6);
+    assert!(segments.windows(2).all(|p| p[0]["vma"].as_u64() < p[1]["vma"].as_u64()));
+    let auto0 = segments.iter().find(|p| p["section"] == ".arm7.autoload0").unwrap();
+    assert_eq!(auto0["vma"], 0x037f8000u32);
+    assert_eq!(auto0["lma"], 0x02380040u32);
+    assert_eq!(auto0["file_bytes"], 16);
+    assert_eq!(auto0["memory_bytes"], 16);
+    let bss0 = segments.iter().find(|p| p["section"] == ".arm7.bss.autoload0").unwrap();
+    assert_eq!(bss0["file_bytes"], 0);
+    assert_eq!(bss0["memory_bytes"], 8);
+    assert_eq!(f.parent, original);
+}
