+        "-T",
+        "physical.ld",
+        "-o",
+        "bad.elf",
+        objects[0],
+        objects[1],
+        objects[2],
+        objects[3],
+    ];
+    let original = fs::read(p.join("autoload0.o")).unwrap();
+    fs::write(p.join("autoload0.o"), fs::read(p.join("autoload1.o")).unwrap()).unwrap();
+    assert!(run(&pins.lld.executable, &args, &p).is_err());
+    fs::write(p.join("autoload0.o"), original).unwrap();
+    fs::remove_file(p.join("autoload0.o")).unwrap();
+    assert!(run(&pins.lld.executable, &args, &p).is_err());
+}
