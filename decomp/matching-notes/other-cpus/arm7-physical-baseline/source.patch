+#[test]
+fn actual_elf_section_directory_and_entry_anchor_mutations_reject() {
+    let f = Fixture::new(&[1, 2, 3, 4]);
+    let view = f.parent_layout.checked(&f.parent).unwrap();
+    let p = out();
+    build(&view, &pins(), &p).unwrap();
+    let elf = fs::read(p.join("linked.elf")).unwrap();
+    let sh = word(&elf, 32).unwrap();
+    let strings = sh + half(&elf, 50).unwrap() as u32 * 40;
+    let sym = section(&elf, ".symtab");
+    let mut accepted = Vec::new();
+    for (label, offset, value) in [
+        ("section names type", strings + 4, 1),
+        ("null section", sh + 4, 3),
+        ("missing entry anchor", sym + 20, 16),
+    ] {
+        let mut mutant = elf.clone();
+        set(&mut mutant, offset, value);
+        if validate_linked(&view, &mutant).is_ok() {
+            accepted.push(label);
+        }
+    }
+    assert!(accepted.is_empty(), "accepted malformed metadata: {accepted:?}");
+}
