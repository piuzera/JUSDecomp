new file mode 100644
index 0000000000000000000000000000000000000000..a239d133aca67f8e84f337ab2883c56e7d3e5abf
--- /dev/null
+++ b/lib/examples/arm7_physical_baseline.rs
@@ -0,0 +1,202 @@
+use ds_decomp::rom::{
+    arm7::Arm7Layout,
+    arm7_physical_baseline::{NativePins, build},
+};
+use sha2::{Digest, Sha256};
+use std::{error::Error, fs, io, path::Path};
+
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn reject(reason: &'static str) -> Box<dyn Error> {
+    Box::new(io::Error::other(reason))
+}
+fn execute(args: &[String]) -> Result<serde_json::Value, Box<dyn Error>> {
+    if args.len() != 6 {
+        return Err(reject(
+            "expected parent ROM, layout sidecar, layout SHA256, native pins, pins SHA256, fresh output directory",
+        ));
+    }
+    let parent = fs::read(&args[0])?;
+    let layout_bytes = fs::read(&args[1])?;
+    let native_bytes = fs::read(&args[3])?;
+    if digest(&layout_bytes) != args[2] || digest(&native_bytes) != args[4] {
+        return Err(reject("sidecar digest mismatch"));
+    }
+    let layouts: Vec<Arm7Layout> = serde_json::from_slice(&layout_bytes)?;
+    if layouts.is_empty() {
+        return Err(reject("no selected programs"));
+    }
+    for (i, layout) in layouts.iter().enumerate() {
+        if layouts[..i].iter().any(|other| other.identity == layout.identity) {
+            return Err(reject("duplicate selected program identity"));
+        }
+    }
+    let native: NativePins = serde_json::from_slice(&native_bytes)?;
+    let views =
+        layouts.iter().map(|layout| layout.checked(&parent)).collect::<Result<Vec<_>, _>>()?;
+    let executable = std::env::current_exe()?;
+    let executable_hash = digest(&fs::read(&executable)?);
+    let parent_hash = digest(&parent);
+    let output = Path::new(&args[5]);
+    fs::create_dir(output)?;
+    let mut programs = Vec::new();
+    for (i, view) in views.iter().enumerate() {
+        let directory = output.join(format!("program-{i}"));
+        fs::create_dir(&directory)?;
+        let mut report = serde_json::to_value(build(view, &native, &directory)?)?;
+        report["layout_sidecar_sha256"] = args[2].clone().into();
+        report["native_pins_sidecar_sha256"] = args[4].clone().into();
+        programs.push(report);
+    }
+    for (i, program) in programs.iter().enumerate() {
+        let artifacts =
+            program["artifacts"].as_array().ok_or_else(|| reject("missing artifact inventory"))?;
+        for artifact in artifacts {
+            let name = artifact["name"].as_str().ok_or_else(|| reject("missing artifact name"))?;
+            let bytes = fs::read(output.join(format!("program-{i}")).join(name))?;
+            if artifact["bytes"].as_u64() != Some(bytes.len() as u64)
+                || artifact["sha256"].as_str() != Some(digest(&bytes).as_str())
+            {
+                return Err(reject("native artifact changed before publication"));
+            }
+        }
+    }
+    for tool in [&native.clang, &native.lld] {
+        if digest(&fs::read(&tool.executable)?) != tool.sha256 {
+            return Err(reject("native tool changed before publication"));
+        }
+    }
+    if digest(&fs::read(&args[0])?) != parent_hash
+        || digest(&fs::read(&args[1])?) != args[2]
+        || digest(&fs::read(&args[3])?) != args[4]
+        || digest(&fs::read(executable)?) != executable_hash
+    {
+        return Err(reject("input changed during native build"));
+    }
+    Ok(serde_json::json!({"status":"opaque_physical_baselines_verified","programs":programs,
+        "parent_rom_sha256":parent_hash,"layout_sidecar_sha256":args[2],"native_pins_sidecar_sha256":args[4],
+        "producer_binary_sha256":executable_hash,"inputs_unchanged":true,"source_bytes":0,"t10_complete":false}))
+}
+fn main() {
+    match execute(&std::env::args().skip(1).collect::<Vec<_>>()) {
+        Ok(report) => println!("{}", serde_json::to_string_pretty(&report).unwrap()),
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use sha2::{Digest, Sha256};
+    use std::{
+        fs,
+        path::PathBuf,
+        sync::atomic::{AtomicUsize, Ordering},
+    };
+    mod common {
+        include!(concat!(env!("CARGO_MANIFEST_DIR"), "/tests/common/mod.rs"));
+    }
+    use common::Fixture;
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+    fn sha(b: &[u8]) -> String {
+        format!("{:x}", Sha256::digest(b))
+    }
+    fn setup(duplicates: bool) -> Vec<String> {
+        let f = Fixture::new(&[1, 2, 3, 4]);
+        let root = PathBuf::from(std::env::var_os("CARGO_TARGET_DIR").unwrap()).join(format!(
+            "example-test-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir_all(&root).unwrap();
+        let layouts = if duplicates {
+            serde_json::to_vec(&vec![&f.parent_layout, &f.parent_layout]).unwrap()
+        } else {
+            serde_json::to_vec(&vec![&f.parent_layout, &f.child_layout]).unwrap()
+        };
+        let tools=serde_json::to_vec(&serde_json::json!({"clang":{"executable":"/opt/homebrew/opt/llvm/bin/clang","sha256":"d64d1ee59d8aff01397eb88adea263e490ac65766faefc8b5323b4a06d0438e5","version":"Homebrew clang version 23.1.2"},"lld":{"executable":"/opt/homebrew/bin/ld.lld","sha256":"3c9298dbaf1389f490e72bc055e9595cfe5f125e078deff9bedb4c54ceb15a54","version":"Homebrew LLD 23.1.2 (compatible with GNU linkers)"}})).unwrap();
+        fs::write(root.join("parent.nds"), f.parent).unwrap();
+        fs::write(root.join("layouts.json"), &layouts).unwrap();
+        fs::write(root.join("tools.json"), &tools).unwrap();
+        vec![
+            root.join("parent.nds").display().to_string(),
+            root.join("layouts.json").display().to_string(),
+            sha(&layouts),
+            root.join("tools.json").display().to_string(),
+            sha(&tools),
+            root.join("output").display().to_string(),
+        ]
+    }
+    #[test]
+    fn example_consumes_pinned_bytes_and_retains_per_program_identity_and_pin() {
+        let args = setup(false);
+        let result = execute(&args).unwrap();
+        let programs = result["programs"].as_array().unwrap();
+        assert_eq!(programs.len(), 2);
+        assert_ne!(programs[0]["identity"], programs[1]["identity"]);
+        for p in programs {
+            assert_eq!(p["layout_sidecar_sha256"], args[2]);
+            assert_eq!(p["source_bytes"], 0);
+        }
+        assert_eq!(result["inputs_unchanged"], true);
+    }
+    #[test]
+    fn original_file_changed_after_snapshot_rejects_native_success() {
+        let args = setup(false);
+        let watched = PathBuf::from(&args[5]).join("program-0/startup.bin");
+        let original = args[0].clone();
+        let writer = std::thread::spawn(move || {
+            let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+            while !watched.exists() {
+                assert!(std::time::Instant::now() < deadline, "native build did not start");
+                std::thread::sleep(std::time::Duration::from_millis(1));
+            }
+            fs::write(original, b"mutated original after checked snapshot").unwrap();
+        });
+        let result = execute(&args);
+        writer.join().unwrap();
+        assert!(result.is_err(), "native success credited changed original file");
+    }
+    #[test]
+    fn first_program_output_changed_during_second_build_rejects_publication() {
+        let args = setup(false);
+        let watched = PathBuf::from(&args[5]).join("program-1/startup.bin");
+        let output = PathBuf::from(&args[5]).join("program-0/linked.elf");
+        let writer = std::thread::spawn(move || {
+            let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+            while !watched.exists() {
+                assert!(std::time::Instant::now() < deadline, "second native build did not start");
+                std::thread::sleep(std::time::Duration::from_millis(1));
+            }
+            let mut bytes = fs::read(&output).unwrap();
+            bytes[18..20].copy_from_slice(&[0, 0]);
+            fs::write(output, bytes).unwrap();
+        });
+        let result = execute(&args);
+        writer.join().unwrap();
+        assert!(result.is_err(), "published stale first-program artifact");
+    }
+    #[test]
+    fn duplicate_selected_identity_rejects_before_artifact_creation() {
+        let args = setup(true);
+        assert!(execute(&args).is_err());
+        assert!(!std::path::Path::new(&args[5]).exists());
+    }
+    #[test]
+    fn changed_sidecar_or_wrong_digest_rejects_before_artifact_creation() {
+        for index in [2, 4] {
+            let mut args = setup(false);
+            args[index] = "0".repeat(64);
+            assert!(execute(&args).is_err());
+            assert!(!std::path::Path::new(&args[5]).exists());
+        }
+        let args = setup(false);
+        fs::write(&args[1], b"[]").unwrap();
+        assert!(execute(&args).is_err());
+        assert!(!std::path::Path::new(&args[5]).exists());
+    }
+}
