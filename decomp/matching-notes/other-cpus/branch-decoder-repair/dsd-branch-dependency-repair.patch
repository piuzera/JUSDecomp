+#[test]
+fn thumb_blx_halfword_aligned_pc_llvm() {
+    // Unlike BL, BLX uses Align(PC, 4). These expected targets come from
+    // thumb-blx-alignment-disassembly.txt, including both displacement edges.
+    check(
+        &[0x00, 0xf0, 0x00, 0xe8],
+        0x02380002,
+        ParseMode::Thumb,
+        ArmVersion::V5Te,
+        0x02380004,
+        "blx",
+    );
+    check(
+        &[0xff, 0xf3, 0xfe, 0xef],
+        0x02380006,
+        ParseMode::Thumb,
+        ArmVersion::V5Te,
+        0x02780004,
+        "blx",
+    );
+    check(
+        &[0x00, 0xf4, 0x00, 0xe8],
+        0x0238000a,
+        ParseMode::Thumb,
+        ArmVersion::V5Te,
+        0x01f8000c,
+        "blx",
+    );
+    check(
+        &[0xff, 0xf7, 0xfe, 0xef],
+        0x0238000e,
+        ParseMode::Thumb,
+        ArmVersion::V5Te,
+        0x0238000c,
+        "blx",
+    );
+}
