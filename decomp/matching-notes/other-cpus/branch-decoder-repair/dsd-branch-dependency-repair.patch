+// Synthetic expected addresses come from the committed independent LLVM23.1.2 oracle.
+use unarm::{args::Argument, ArmVersion, Endian, ParseFlags, ParseMode, Parser};
+
+fn check(bytes: &[u8], source: u32, mode: ParseMode, version: ArmVersion, expected: u32, mnemonic: &str) {
+    let flags = ParseFlags { version, ual: false };
+    let mut parser = Parser::new(mode, source, Endian::Little, flags, bytes);
+    let (address, _, parsed) = parser.next().expect("complete fixture");
+    assert_eq!(address, source);
+    assert_eq!(parsed.mnemonic, mnemonic);
+    let Argument::BranchDest(displacement) = parsed.args[0] else {
+        panic!("no direct branch destination");
+    };
+    assert_eq!(
+        address.wrapping_add_signed(displacement),
+        expected,
+        "{mnemonic} at {source:#010x}"
+    );
+    assert!(parser.next().is_none());
+}
+
+#[test]
+fn arm_b_bl_llvm_boundaries() {
+    // b_large_positive
+    check(
+        &[0x18, 0xe1, 0x51, 0xea],
+        0x02380000,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x037f8468,
+        "b",
+    );
+    // bl_large_positive
+    check(
+        &[0x17, 0xe1, 0x51, 0xeb],
+        0x02380004,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x037f8468,
+        "bl",
+    );
+    // b_large_negative
+    check(
+        &[0xfc, 0xff, 0xbf, 0xea],
+        0x02380008,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x01380000,
+        "b",
+    );
+    // bl_large_negative
+    check(
+        &[0xfb, 0xff, 0xbf, 0xeb],
+        0x0238000c,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x01380000,
+        "bl",
+    );
+    // b_max_positive
+    check(
+        &[0xff, 0xff, 0x7f, 0xea],
+        0x02380010,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x04380014,
+        "b",
+    );
+    // bl_max_positive
+    check(
+        &[0xff, 0xff, 0x7f, 0xeb],
+        0x02380014,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x04380018,
+        "bl",
+    );
+    // b_min_negative
+    check(
+        &[0x00, 0x00, 0x80, 0xea],
+        0x02380018,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x00380020,
+        "b",
+    );
+    // bl_min_negative
+    check(
+        &[0x00, 0x00, 0x80, 0xeb],
+        0x0238001c,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x00380024,
+        "bl",
+    );
+    // b_minus_one_word
+    check(
+        &[0xff, 0xff, 0xff, 0xea],
+        0x02380020,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x02380024,
+        "b",
+    );
+    // bl_zero_displacement
+    check(
+        &[0x00, 0x00, 0x00, 0xeb],
+        0x02380024,
+        ParseMode::Arm,
+        ArmVersion::V4T,
+        0x0238002c,
+        "bl",
+    );
+}
