++// Synthetic expected addresses come from the committed independent LLVM23.1.2 oracle.
++use unarm::{args::Argument, ArmVersion, Endian, ParseFlags, ParseMode, Parser};
++
++fn check(bytes: &[u8], source: u32, mode: ParseMode, version: ArmVersion, expected: u32, mnemonic: &str) {
++    let flags = ParseFlags { version, ual: false };
++    let mut parser = Parser::new(mode, source, Endian::Little, flags, bytes);
++    let (address, _, parsed) = parser.next().expect("complete fixture");
++    assert_eq!(address, source);
++    assert_eq!(parsed.mnemonic, mnemonic);
++    let Argument::BranchDest(displacement) = parsed.args[0] else {
++        panic!("no direct branch destination");
++    };
++    assert_eq!(
++        address.wrapping_add_signed(displacement),
++        expected,
++        "{mnemonic} at {source:#010x}"
++    );
++    assert!(parser.next().is_none());
++}
