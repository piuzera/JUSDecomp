+#[test]
+fn v4t_rejects_arm_and_thumb_blx() {
+    let flags = ParseFlags {
+        version: ArmVersion::V4T,
+        ual: false,
+    };
+    let bytes = [0xff, 0xff, 0x7f, 0xfa];
+    let (_, _, parsed) = Parser::new(ParseMode::Arm, 0x02380028, Endian::Little, flags, &bytes)
+        .next()
+        .unwrap();
+    assert!(!matches!(parsed.args[0], Argument::BranchDest(_)), "V4T accepted BLX");
+    let bytes = [0xff, 0xff, 0x7f, 0xfb];
+    let (_, _, parsed) = Parser::new(ParseMode::Arm, 0x0238002c, Endian::Little, flags, &bytes)
+        .next()
+        .unwrap();
+    assert!(!matches!(parsed.args[0], Argument::BranchDest(_)), "V4T accepted BLX");
+    let bytes = [0x00, 0x00, 0x80, 0xfa];
+    let (_, _, parsed) = Parser::new(ParseMode::Arm, 0x02380030, Endian::Little, flags, &bytes)
+        .next()
+        .unwrap();
+    assert!(!matches!(parsed.args[0], Argument::BranchDest(_)), "V4T accepted BLX");
+    let bytes = [0x00, 0x00, 0x80, 0xfb];
+    let (_, _, parsed) = Parser::new(ParseMode::Arm, 0x02380034, Endian::Little, flags, &bytes)
+        .next()
+        .unwrap();
+    assert!(!matches!(parsed.args[0], Argument::BranchDest(_)), "V4T accepted BLX");
+    let bytes = [0xff, 0xf3, 0xfe, 0xef];
+    let (_, _, parsed) = Parser::new(ParseMode::Thumb, 0x02380014, Endian::Little, flags, &bytes)
+        .next()
+        .unwrap();
+    assert!(!matches!(parsed.args[0], Argument::BranchDest(_)), "V4T accepted BLX");
+    let bytes = [0x00, 0xf4, 0x00, 0xe8];
+    let (_, _, parsed) = Parser::new(ParseMode::Thumb, 0x02380018, Endian::Little, flags, &bytes)
+        .next()
+        .unwrap();
+    assert!(!matches!(parsed.args[0], Argument::BranchDest(_)), "V4T accepted BLX");
+    let bytes = [0xff, 0xf7, 0xfe, 0xef];
+    let (_, _, parsed) = Parser::new(ParseMode::Thumb, 0x0238001c, Endian::Little, flags, &bytes)
+        .next()
+        .unwrap();
+    assert!(!matches!(parsed.args[0], Argument::BranchDest(_)), "V4T accepted BLX");
+    let bytes = [0x00, 0xf0, 0x00, 0xe8];
+    let (_, _, parsed) = Parser::new(ParseMode::Thumb, 0x02380020, Endian::Little, flags, &bytes)
+        .next()
+        .unwrap();
+    assert!(!matches!(parsed.args[0], Argument::BranchDest(_)), "V4T accepted BLX");
+}
