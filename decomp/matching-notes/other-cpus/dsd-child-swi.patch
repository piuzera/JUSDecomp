+    pub fn find_startup_swi_functions(
+        module_code: &[u8],
+        base_addr: u32,
+        entry_addr: u32,
+        symbol_map: &mut SymbolMap,
+    ) -> BTreeMap<u32, Function> {
+        // Download Play programs may place BIOS wrappers after the secure area.
+        let pre_entry_size = (entry_addr & !1).saturating_sub(base_addr) as usize;
+        let prefix_size = pre_entry_size.max(0x800).min(module_code.len());
+        Self::find_secure_area_functions(&module_code[..prefix_size], base_addr, symbol_map)
+    }
