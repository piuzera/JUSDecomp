 #[cfg(test)]
 mod tests {
     use super::{Function, FunctionParseOptions};
+    use crate::config::symbol::SymbolMap;
+
+    #[test]
+    fn startup_swi_prefix_includes_halfword_aligned_wrapper_before_entry() {
+        const BASE: u32 = 0x02000000;
+        let mut code = vec![0; 0x800];
+        // Public invented BIOS wrappers: Mod is six bytes, CpuSet is four bytes.
+        code.extend_from_slice(&[0x09, 0xdf, 0x08, 0x1c, 0x70, 0x47]);
+        code.extend_from_slice(&[0x0b, 0xdf, 0x70, 0x47]);
+        // This wrapper is after the entry boundary and must not be scanned.
+        code.extend_from_slice(&[0x0c, 0xdf, 0x70, 0x47]);
+        let mut symbols = SymbolMap::new();
+        let functions =
+            Function::find_startup_swi_functions(&code, BASE, BASE + 0x80a, &mut symbols);
+        assert_eq!(functions.len(), 2);
+        let cpu_set = functions.get(&(BASE + 0x806)).unwrap();
+        assert_eq!(cpu_set.name(), "CpuSet");
+        assert_eq!(cpu_set.start_address(), BASE + 0x806);
+        assert_eq!(cpu_set.end_address(), BASE + 0x80a);
+        assert!(cpu_set.is_thumb());
+        assert_eq!(functions.get(&(BASE + 0x800)).unwrap().name(), "Mod");
+    }
+
+    #[test]
+    fn adjacent_swi_wrappers_each_produce_a_function() {
+        const BASE: u32 = 0x02000000;
+        let code = [0x0b, 0xdf, 0x70, 0x47, 0x0c, 0xdf, 0x70, 0x47];
+        let mut symbols = SymbolMap::new();
+        let functions = Function::find_secure_area_functions(&code, BASE, &mut symbols);
+        assert_eq!(functions.len(), 2);
+        assert_eq!(functions.get(&BASE).unwrap().name(), "CpuSet");
+        assert_eq!(functions.get(&(BASE + 4)).unwrap().name(), "CpuFastSet");
+    }
+
+    #[test]
+    fn startup_swi_scan_is_bounded_to_actual_module_bytes() {
+        const BASE: u32 = 0x02000000;
+        let code = [0x0b, 0xdf, 0x70, 0x47];
+        for entry in [0, BASE, BASE + 4, u32::MAX] {
+            let mut symbols = SymbolMap::new();
+            let functions =
+                Function::find_startup_swi_functions(&code, BASE, entry, &mut symbols);
+            assert_eq!(functions.len(), 1);
+            assert_eq!(functions.get(&BASE).unwrap().end_address(), BASE + 4);
+        }
+    }

