    "incoming": "r0 readable stable NUL-terminated bytes; no additional incoming data argument or stack value consumed; LR supplies the return target",
    "seed": 0,
    "recurrence": "h_next = h XOR ((signed8(b) OR (h << 1)) AND 0xffff)",
    "operation_order": "signed body load; OR old accumulator shifted1; truncate OR to16; XOR old accumulator",
    "reads": "precheck signed byte at p; if nonzero reread p with postincrement1; update; repeat; terminal NUL read once",
    "loads_for_n_stable_nonzero_bytes": "2*n + 1",
    "return": "r0 = zero-extended h in0..65535; empty input0; r1=0; r2=h",
    "writes": "No memory writes; no stack use; r3..r12,sp,lr untouched",
    "flags_at_normal_return": "N=0,Z=1,C=1,V=0 from final CMP zero",
